# Frontend facility display currency settings
# These values affect presentation only; they do not convert or change stored amounts.
VITE_CURRENCY=GHS
VITE_CURRENCY_LOCALE=en-GH

# API base URL. Defaults to /api (same-origin) which works for the Electron desktop
# app and Vite dev proxy. Override when the API is on a different host/port.
VITE_API_URL=/api
