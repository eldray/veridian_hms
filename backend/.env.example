# Veridian HMS backend configuration.
# Copy to backend/.env for local development. Never commit the filled file.
# Values are read at process start; restart the backend after changing them.
# Only settings the backend actually reads are listed here.

# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Bind address. The packaged desktop app sets 127.0.0.1. Leave empty to listen on
# all interfaces (development server / LAN deployment behind a reverse proxy).
HOST=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veridian_hms?schema=public"
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# ── Browser and file access ─────────────────────────────────────────────────
# Comma-separated extra origins allowed by CORS. Same-origin requests and the
# bundled desktop UI are always allowed; the Vite dev server (http://localhost:3000)
# is only added when NODE_ENV is not "production".
CORS_ALLOWED_ORIGINS=
# Set to true only when the UI is served over HTTPS (e.g. behind a TLS proxy).
COOKIE_SECURE=false
# Lifetime of the HttpOnly cookie used to load patient/scan/document files.
# Default: 86400 (24 hours). It is re-issued on every token refresh.
FILE_ACCESS_TTL_SECONDS=86400

# ── Seeding and first-run bootstrap ─────────────────────────────────────────
# Development only. Never enable in production.
ENABLE_SEEDING=false
RUN_SEED=false
# Used once by the desktop first-run bootstrap to create the administrator.
INITIAL_ADMIN_PASSWORD=
SEED_DATA_DIR=

# ── Authentication and sessions ─────────────────────────────────────────────
JWT_EXPIRES_IN=24h
# Access-token and refresh-token lifetimes; format: 30m, 12h, 7d.
JWT_REFRESH_EXPIRY=7d
# bcrypt cost factor, 10-15. Higher is slower to hash and harder to brute force.
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_IP_MAX_ATTEMPTS=100
LOGIN_WINDOW_MIN=15
API_RATE_LIMIT_PER_MIN=1500
API_ANON_RATE_LIMIT_PER_MIN=300
RATE_LIMIT_DISABLED=false

# ── Database tuning ─────────────────────────────────────────────────────────
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=20
PRISMA_LOG_QUERIES=false

# ── Reporting ───────────────────────────────────────────────────────────────
# Longest period one report may cover, in days.
REPORT_MAX_DAYS=366
REPORT_MAX_CONCURRENT=2

# ── Backups ─────────────────────────────────────────────────────────────────
# pg_dump, pg_restore and psql must be available on the host; the desktop
# installer does not bundle them. Set explicit paths when they are not on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
# Required for restoring plain .sql dumps (custom .backup files use pg_restore).
PG_PSQL_PATH=

# ── SMS and WhatsApp (Hubtel) ───────────────────────────────────────────────
# When disabled, messages are still queued in the database but not dispatched.
HUBTEL_ENABLED=false
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_SMS_URL=https://sms.hubtel.com/v1/messages/send
HUBTEL_WHATSAPP_URL=
HUBTEL_WHATSAPP_FROM=

# ── MTN MoMo ────────────────────────────────────────────────────────────────
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_USER_ID=
MOMO_CREDENTIAL_TOKEN=

# ── NHIS / claims ───────────────────────────────────────────────────────────
NHIS_FACILITY_CODE=
NHIS_API_CLIENT_SECRET=

# ── CLAIM-it (NHIS claims server) ───────────────────────────────────────────
# The claims adjudication server installed at the facility. Leave CLAIMIT_ENABLED
# false until you are ready to submit: claims are then still prepared and
# downloaded as XML, but nothing is sent to NHIS.
#
# The credentials are kept here and never in the database. A token request sends
# them in its query string, so anything that logs request lines - the CLAIM-it
# host, a proxy, a Windows HTTP trace - captures them. Run CLAIM-it on localhost
# or a facility VLAN; the port is plain HTTP.
CLAIMIT_ENABLED=false
# Host and port only, for example http://localhost:31719 - the /json-api or
# /xml-api mount is chosen by CLAIMIT_FORMAT.
CLAIMIT_BASE_URL=
CLAIMIT_USERNAME=
CLAIMIT_PASSWORD=
# json sends the claim array to /json-api; xml sends the v2.1 document to /xml-api.
CLAIMIT_FORMAT=json
# A batch of claims is a large POST; the default is 30 seconds.
CLAIMIT_TIMEOUT_MS=30000
# CLAIM-it returns no token expiry, so this is how long one is assumed valid.
CLAIMIT_TOKEN_TTL_MS=900000

# ── Desktop, realtime and logging ───────────────────────────────────────────
ELECTRON=false
FRONTEND_DIST=
SSE_MAX_CLIENTS=500
APP_VERSION=1.0.0
LOG_LEVEL=info
# Prints the demo/test account usernames and passwords at startup. Leave false
# everywhere except a disposable local development database.
SHOW_DEV_CREDENTIALS=false
