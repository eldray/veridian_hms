model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  senderId   String?
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority
  actionType String?
  actionId   String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  isArchived Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readAt     DateTime?
  updatedAt  DateTime             @updatedAt

  user   User  @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
}

model ServiceRendered {
  id            String   @id @default(cuid())
  attendanceId  String
  serviceItemId String
  quantity      Int      @default(1)
  date          DateTime @default(now())
  performedById String
  notes         String?
  createdAt     DateTime @default(now())

  Attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [performedById], references: [id])
  ServiceCatalog ServiceCatalog @relation(fields: [serviceItemId], references: [id])
}

