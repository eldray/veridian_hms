}

model PatientWaiver {
  id              String       @id @default(cuid())
  patientId       String
  billId          String?
  waiverType      WaiverType
  reason          String
  amountRequested Decimal      @db.Decimal(15, 2)
  amountApproved  Decimal      @db.Decimal(15, 2) @default(0)
