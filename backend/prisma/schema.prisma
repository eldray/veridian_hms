  Requisition_Requisition_approvedByIdToUser      Requisition[]             @relation("Requisition_approvedByIdToUser")
  Requisition_Requisition_fulfilledByIdToUser     Requisition[]             @relation("Requisition_fulfilledByIdToUser")
  Requisition_Requisition_requestedByIdToUser     Requisition[]             @relation("Requisition_requestedByIdToUser")
  Scan_Scan_createdByIdToUser                     Scan[]                    @relation("Scan_createdByIdToUser")
  Scan_Scan_performedByIdToUser                   Scan[]                    @relation("Scan_performedByIdToUser")
  Scan_Scan_verifiedByIdToUser                    Scan[]                    @relation("Scan_verifiedByIdToUser")
  ServiceCatalog                                  ServiceCatalog[]
  ServiceRendered                                 ServiceRendered[]
  Vitals                                          Vitals[]
  clinicianAppointments                           Appointment[]             @relation("ClinicianAppointments")
  AuditLog                                        AuditLog[]
  ReportExecution                                 ReportExecution[]
  DocumentTemplate                                DocumentTemplate[]
  GeneratedDocument                               GeneratedDocument[]
  NHISEligibilityCheck                            NHISEligibilityCheck[]
  PreAuthorisationRequest_requested               PreAuthorisationRequest[] @relation("PreAuth_requestedBy")
  PreAuthorisationRequest_updated                 PreAuthorisationRequest[] @relation("PreAuth_updatedBy")

