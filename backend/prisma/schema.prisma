  admission          Admission?            @relation(fields: [admissionId], references: [id])
  Patient            Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_createdBy     User                  @relation("ProformaInvoice_createdByIdToUser", fields: [createdById], references: [id])
  User_approvedBy    User?                 @relation("ProformaInvoice_approvedByIdToUser", fields: [approvedById], references: [id])
  Bill               Bill?                 @relation(fields: [convertedToBillId], references: [id])
  items              ProformaInvoiceItem[]
  CorporateAccount   CorporateAccount?     @relation(fields: [corporateAccountId], references: [id])
  corporateAccountId String?

  @@index([patientId])
  @@index([status])
  @@index([referenceNumber])
  @@index([createdAt])
}

model ProformaInvoiceItem {
  id                    String      @id @default(cuid())
  proformaInvoiceId     String
  serviceCatalogId      String?
  description           String
  serviceType           ServiceType
  quantity              Int         @default(1)
  unitPrice             Decimal     @db.Decimal(15, 2)
  pricingBasis          PaymentMode
  vatRate               Float       @default(0)
  vatAmount             Decimal     @db.Decimal(15, 2) @default(0)
  totalPrice            Decimal     @db.Decimal(15, 2)
  isInsuranceCovered    Boolean     @default(false)
  insuranceCoverage     Decimal     @db.Decimal(15, 2) @default(0)
  patientResponsibility Decimal     @db.Decimal(15, 2)

  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  serviceCatalog  ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([proformaInvoiceId])
}

// ============================================================
// SMS/WHATSAPP INTEGRATION (FIXED: Removed Secrets)
// ============================================================

model CommunicationChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  String
  // REMOVED: apiKey, apiSecret (Store in .env)
  senderId  String?
  isActive  Boolean  @default(false)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates CommunicationTemplate[]
  logs      CommunicationLog[]

  @@map("communication_channels")
}

model CommunicationTemplate {
  id        String            @id @default(cuid())
  channelId String
  name      String
  type      CommunicationType
  subject   String?
  body      String
  variables Json?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  channel CommunicationChannel @relation(fields: [channelId], references: [id])
  logs    CommunicationLog[]

  @@index([channelId])
  @@index([type])
  @@map("communication_templates")
}

model CommunicationLog {
  id                String              @id @default(cuid())
  channelId         String
  templateId        String?
  recipient         String
  message           String
  status            CommunicationStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  metadata          Json?
  cost              Decimal?            @db.Decimal(15, 2)
  providerMessageId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  channel  CommunicationChannel   @relation(fields: [channelId], references: [id])
  template CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([recipient])
  @@index([status])
  @@index([createdAt])
  @@index([channelId])
  @@map("communication_logs")
}

// ============================================================
// FAMILY PLANNING
// ============================================================

model FamilyPlanningService {
  id                String      @id @default(cuid())
  patientId         String
  attendanceId      String?     
  serviceDate       DateTime    @default(now())
  
  method            FPMethod
  methodCategory    FPMethodCategory
  isNewAcceptor     Boolean     @default(false)
  
  counsellingGiven  Boolean     @default(true)
  informedConsent   Boolean     @default(true)
  
  sideEffects       String?
  contraindications String?
  medicalEligibilityCategory Int?  
  
  nextFollowUpDate  DateTime?
  followUpStatus    String?
  
  isPostpartum      Boolean     @default(false)
  isPostAbortion    Boolean     @default(false)
  postpartumWeeks   Int?
  
  cypFactor         Float       @default(1.0)
  
  providedById      String
  notes             String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  patient           Patient     @relation(fields: [patientId], references: [id])
  attendance        Attendance? @relation(fields: [attendanceId], references: [id])
  providedBy        User        @relation(fields: [providedById], references: [id])
  
  @@index([patientId])
  @@index([serviceDate])
  @@index([method])
  @@index([methodCategory])
  @@map("family_planning_services")
}

// ============================================================
// CORPORATE ACCOUNTS
// ============================================================

model CorporateAccount {
  id                  String              @id @default(cuid())
  companyName         String
  registrationNumber  String?             @unique
  taxId               String?
  contactPerson       String
  email               String
  phone               String
  address             String?
  creditLimit         Decimal             @db.Decimal(15, 2) @default(0)
  currentBalance      Decimal             @db.Decimal(15, 2) @default(0)
  paymentTerms        Int                 @default(30)
  discountPercentage  Float               @default(0)
  isActive            Boolean             @default(true)
  insuranceProviderId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  bills               Bill[]              @relation("CorporateAccountBills")
  insuranceProvider   InsuranceProvider?  @relation(fields: [insuranceProviderId], references: [id])
  employees           CorporateEmployee[]
  invoices            Invoice[]
  proformaInvoices    ProformaInvoice[]
  Attendance          Attendance[]
  InsuranceClaim      InsuranceClaim[]

  @@index([insuranceProviderId])
  @@index([registrationNumber])
  @@map("corporate_accounts")
}

model CorporateEmployee {
  id             String    @id @default(cuid())
  employeeId     String
  firstName      String
  lastName       String
  otherNames     String?
  dateOfBirth    DateTime?
  gender         Gender?
  phone          String?
  email          String?
  department     String?
  position       String?
  enrollmentDate DateTime  @default(now())
  endDate        DateTime?
  isActive       Boolean   @default(true)
  accountId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account     CorporateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([accountId, employeeId])
  @@index([accountId])
  @@map("corporate_employees")
}

