  createdAt        DateTime       @default(now())

  deliveryRecord DeliveryRecord @relation(fields: [deliveryRecordId], references: [id])

  @@map("newborn_records")
}

model AbortionRecord {
  id               String          @id @default(cuid())
  patientId        String
  attendanceId     String
  abortionDate     DateTime
  gestationalWeeks Int
  abortionType     AbortionType
  complication     String?
  method           AbortionMethod?
  createdById      String
  createdAt        DateTime        @default(now())

  patient         Patient          @relation(fields: [patientId], references: [id])
  attendance      Attendance       @relation(fields: [attendanceId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  deliveryRecords DeliveryRecord[]

  @@index([abortionDate])
  @@map("abortion_records")
}

// ============================================================
// PROFORMA INVOICES (Estimates for Private Patients)
// ============================================================

model ProformaInvoice {
  id                 String                @id @default(cuid())
  referenceNumber    String                @unique
  patientId          String
  attendanceId       String?               @unique
  admissionId        String?
  status             ProformaInvoiceStatus @default(DRAFT)
  subtotal           Float                 @default(0)
  discount           Float                 @default(0)
  taxAmount          Float                 @default(0)
  totalAmount        Float                 @default(0)
  validityDays       Int                   @default(7)
  expiresAt          DateTime?
  notes              String?
  termsAndConditions String?
  createdById        String
  approvedById       String?
  approvedAt         DateTime?
  convertedToBillId  String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  Attendance         Attendance?           @relation(fields: [attendanceId], references: [id])
  admission          Admission?            @relation(fields: [admissionId], references: [id])
  Patient            Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_createdBy     User                  @relation("ProformaInvoice_createdByIdToUser", fields: [createdById], references: [id])
  User_approvedBy    User?                 @relation("ProformaInvoice_approvedByIdToUser", fields: [approvedById], references: [id])
  Bill               Bill?                 @relation(fields: [convertedToBillId], references: [id])
  items              ProformaInvoiceItem[]
  CorporateAccount   CorporateAccount?     @relation(fields: [corporateAccountId], references: [id])
  corporateAccountId String?

  @@index([patientId])
  @@index([status])
  @@index([referenceNumber])
  @@index([createdAt])
}

model ProformaInvoiceItem {
  id                    String      @id @default(cuid())
  proformaInvoiceId     String
  serviceCatalogId      String?
  description           String
  serviceType           ServiceType
  quantity              Int         @default(1)
  unitPrice             Float
  pricingBasis          PaymentMode
  vatRate               Float       @default(0)
  vatAmount             Float       @default(0)
  totalPrice            Float
  isInsuranceCovered    Boolean     @default(false)
  insuranceCoverage     Float       @default(0)
  patientResponsibility Float

  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  serviceCatalog  ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([proformaInvoiceId])
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

// ============================================================
// SMS/WHATSAPP INTEGRATION (Extends Notification)
// ============================================================

model CommunicationChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  provider  String
  apiKey    String?
  apiSecret String?
  senderId  String?
  isActive  Boolean  @default(false)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates CommunicationTemplate[]
  logs      CommunicationLog[]

  @@map("communication_channels")
}

model CommunicationTemplate {
  id        String            @id @default(cuid())
  channelId String
  name      String
  type      CommunicationType
  subject   String?
  body      String
  variables Json?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  channel CommunicationChannel @relation(fields: [channelId], references: [id])
  logs    CommunicationLog[]

  @@index([channelId])
  @@index([type])
  @@map("communication_templates")
}

model CommunicationLog {
  id                String              @id @default(cuid())
  channelId         String
  templateId        String?
  recipient         String
  message           String
  status            CommunicationStatus @default(PENDING)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  metadata          Json?
  cost              Float?
  providerMessageId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  channel  CommunicationChannel   @relation(fields: [channelId], references: [id])
  template CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([recipient])
  @@index([status])
  @@index([createdAt])
  @@index([channelId])
  @@map("communication_logs")
}

enum CommunicationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMATION
  LAB_RESULT_READY
  PRESCRIPTION_READY
  PAYMENT_REMINDER
  BILL_NOTIFICATION
  WELCOME_MESSAGE
  GENERAL_NOTIFICATION
  CUSTOM
}

enum CommunicationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CommunicationChannelType {
  SMS
  WHATSAPP
  EMAIL
}

