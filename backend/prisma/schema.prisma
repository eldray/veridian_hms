datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id            String      @id @default(cuid())
  entityType    String
  entityId      String
  action        AuditAction
  performedById String
  ipAddress     String?
  userAgent     String?
  previousState Json?
  newState      Json?
  metadata      Json?
  timestamp     DateTime    @default(now())

  performedBy User @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([timestamp])
  @@index([action])
  @@map("audit_logs")
}

model ReportDefinition {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  description  String?
  reportType   ReportType
  parameters   Json?
  templatePath String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  executions ReportExecution[]

  @@map("report_definitions")
}

model ReportExecution {
  id                 String       @id @default(cuid())
  reportDefinitionId String
  reportPeriodStart  DateTime
  reportPeriodEnd    DateTime
  parameters         Json?
  status             ReportStatus @default(pending)
  outputPath         String?
  submittedToGHS     Boolean      @default(false)
  submittedAt        DateTime?
  ghsReferenceNo     String?
  generatedById      String
  generatedAt        DateTime     @default(now())
  completedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime     @default(now())

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id])
  generatedBy      User             @relation(fields: [generatedById], references: [id])

  @@index([reportDefinitionId])
  @@index([reportPeriodStart, reportPeriodEnd])
  @@index([status])
  @@map("report_executions")
}

model DocumentTemplate {
  id           String               @id @default(cuid())
  name         String
  code         String               @unique
  templateType DocumentTemplateType
  content      String
  isActive     Boolean              @default(true)
  isDefault    Boolean              @default(false)
  createdById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  createdBy     User                @relation(fields: [createdById], references: [id])
  generatedDocs GeneratedDocument[]

  @@map("document_templates")
}

model GeneratedDocument {
  id            String   @id @default(cuid())
  templateId    String
  entityType    String
  entityId      String
  filePath      String?
  generatedById String
  generatedAt   DateTime @default(now())

  template    DocumentTemplate @relation(fields: [templateId], references: [id])
  generatedBy User             @relation(fields: [generatedById], references: [id])

  @@index([entityType, entityId])
  @@map("generated_documents")
}

// ============================================================
// PRICING & SERVICE CATALOG (FIXED: Historical Pricing)
// ============================================================

model ServicePricing {
  id               String         @id @default(cuid())
  serviceCatalogId String         // Removed @unique to allow 1-to-N (Historical Pricing)
  cashPrice        Decimal        @db.Decimal(15, 2)
  nhisPrice        Decimal        @db.Decimal(15, 2) @default(0)
  insurancePrice   Decimal        @db.Decimal(15, 2)
  corporatePrice   Decimal        @db.Decimal(15, 2) @default(0)
  vatRate          Float          @default(0)
  isTaxable        Boolean        @default(true)
  effectiveDate    DateTime       @default(now())
  expiryDate       DateTime?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  serviceCatalog   ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Cascade)

  @@index([serviceCatalogId, effectiveDate])
  @@map("service_pricing")
}

model ServiceCatalog {
  id                         String           @id @default(cuid())
  name                       String
  code                       String           @unique
  description                String?
  serviceCategory            ServiceCategory  @default(opd)
  serviceType                ServiceType
  nhisServiceCode            String?
  isNHISCovered              Boolean          @default(true)
  tariffCode                 String?
  nhisCoverageType           NHISCoverageType @default(full)
  nhisRequiresAuth           Boolean          @default(false)
  privateInsRequiresAuth     Boolean          @default(false)
  isPrivateInsuranceExempted Boolean          @default(false)
  unit                       String           @default("Each")
  isPending                  Boolean          @default(true)
  requiresClinicalNotes      Boolean          @default(false)
  subType                    String?
  metadata                   Json?
  isActive                   Boolean          @default(true)

  diagnosisId         String?
  labTestTemplateId   String?
  procedureTemplateId String?
  stockItemId         String?
  wardId              String?
  scanTemplateId      String?
  consultationTypeId  String?
  createdById         String?
  gdrgTariffId        String?

  User              User?              @relation(fields: [createdById], references: [id])
  Diagnosis         Diagnosis?         @relation(fields: [diagnosisId], references: [id])
  LabTestTemplate   LabTestTemplate?   @relation(fields: [labTestTemplateId], references: [id])
  ProcedureTemplate ProcedureTemplate? @relation(fields: [procedureTemplateId], references: [id])
  ScanTemplate      ScanTemplate?      @relation(fields: [scanTemplateId], references: [id])
  StockItem         StockItem?         @relation(fields: [stockItemId], references: [id])
  Ward              Ward?              @relation(fields: [wardId], references: [id])
  ConsultationType  ConsultationType?  @relation(fields: [consultationTypeId], references: [id])
  GDRGTariff        GDRGTariff?        @relation(fields: [gdrgTariffId], references: [id])

  pricing         ServicePricing[]     // Changed to Array for Historical Pricing
  ServiceRendered ServiceRendered[]

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  labTests            LabTest[]
  scans               Scan[]
  procedures          Procedure[]
  medications         Medication[]
  BillLineItem        BillLineItem[]
  ProformaInvoiceItem ProformaInvoiceItem[]

  gdrgProcedureLinks GDRGTariffProcedure[]

  @@index([code])
  @@index([isPrivateInsuranceExempted])
  @@index([nhisCoverageType])
  @@index([nhisServiceCode])
  @@index([serviceCategory, serviceType])
  @@index([serviceType, isPending])
  @@index([isActive])
  @@index([gdrgTariffId])
}

// ============================================================
// PATIENT & CORE EMR (FIXED: Added Histories, Allergies, Consents)
// ============================================================

model Patient {
  id               String       @id @default(cuid())
  folderNumber     String       @unique
  surname          String
  otherNames       String
  gender           Gender
  dateOfBirth      DateTime
  contact          String
  address          String
  paymentMode      PaymentMode?
  insuranceDetails Json?
  additionalInfo   Json?
  billingAddress   Json?
  employer         Json?
  imageUrl         String?

  registeredAt        DateTime @default(now())
  registeredBy        String
  insuranceProviderId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  nhisNumber     String?
  nhisExpiryDate DateTime?
  nhisActive     Boolean   @default(false)
  phoneNumber    String?

  Attendance           Attendance[]
  // Removed Bed relation to prevent redundancy
  Bill                 Bill[]
  InsuranceClaim       InsuranceClaim[]
  InsuranceProvider    InsuranceProvider?     @relation(fields: [insuranceProviderId], references: [id])
  Vitals               Vitals[]
  appointments         Appointment[]
  NHISEligibilityCheck NHISEligibilityCheck[]
  ReferralRecord       ReferralRecord[]
  antenatalBookings    AntenatalBooking[]
  PatientWaiver        PatientWaiver[]
  deliveryRecords      DeliveryRecord[]
  abortionRecords      AbortionRecord[]
  postnatalRecords     PostnatalRecord[]
  proformaInvoices     ProformaInvoice[]
  familyPlanningServices FamilyPlanningService[]

  // NEW: Core EMR Models
  allergies            PatientAllergy[]
  medicalHistories     PatientMedicalHistory[]
  surgicalHistories    PatientSurgicalHistory[]
  familyHistories      PatientFamilyHistory[]
  consents             PatientConsent[]

  @@index([nhisNumber])
  @@index([phoneNumber])
  @@index([dateOfBirth])
  @@index([gender])
  @@index([folderNumber])
  @@index([otherNames])
  @@index([paymentMode])
  @@index([surname])
  @@index([contact])
  @@index([createdAt])
}

// NEW: Core EMR Models
model PatientAllergy {
  id        String   @id @default(cuid())
  patientId String
  allergen  String
  reaction  String?
  severity  String?
  notes     String?
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
}

model PatientMedicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  condition   String
  diagnosedAt DateTime?
  notes       String?
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
}

model PatientSurgicalHistory {
  id          String    @id @default(cuid())
  patientId   String
  procedure   String
  surgeryDate DateTime?
  notes       String?
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
}

model PatientFamilyHistory {
  id        String  @id @default(cuid())
  patientId String
  relation  String
  condition String
  notes     String?
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
}

model PatientConsent {
  id          String       @id @default(cuid())
  patientId   String
  consentType ConsentType
  status      ConsentStatus
  grantedAt   DateTime     @default(now())
  revokedAt   DateTime?
  notes       String?
  documentUrl String?
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId])
}

// ============================================================
// NHIS ELIGIBILITY
// ============================================================

model NHISEligibilityCheck {
  id                     String                 @id @default(cuid())
  patientId              String
  attendanceId           String?
  membershipId           String
  checkMethod            EligibilityCheckMethod
  checkTimestamp         DateTime               @default(now())
  status                 EligibilityStatus
  memberName             String?
  registeredFacilityCode String?
  ccCode                 String?
  membershipExpiry       DateTime?
  responseReference      String?
  rawResponse            Json?
  checkedById            String
  createdAt              DateTime               @default(now())

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attendance Attendance? @relation(fields: [attendanceId], references: [id])
  checkedBy  User        @relation(fields: [checkedById], references: [id])

  @@index([patientId])
  @@index([attendanceId])
  @@index([membershipId])
  @@index([checkTimestamp])
  @@map("nhis_eligibility_checks")
}

// ============================================================
// INSURANCE PROVIDER & PLAN
// ============================================================

model InsuranceProvider {
  id                    String                @id @default(cuid())
  name                  String                @unique
  type                  InsuranceType
  coveragePercentage    Float
  claimSubmissionMethod ClaimSubmissionMethod @default(portal)
  portalUrl             String?
  contactInfo           Json?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  Attendance              Attendance[]
  Bill                    Bill[]
  InsuranceClaim          InsuranceClaim[]
  Patient                 Patient[]
  InsurancePlan           InsurancePlan[]
  PreAuthorisationRequest PreAuthorisationRequest[]
  CorporateAccount        CorporateAccount[]

  @@map("insurance_providers")
}

model InsurancePlan {
  id                  String          @id @default(cuid())
  insuranceProviderId String
  name                String
  serviceCategory     ServiceCategory
  coveragePercentage  Float
  annualLimit         Decimal?        @db.Decimal(15, 2)
  requiresPreAuth     Boolean         @default(false)
  coPaymentAmount     Decimal         @db.Decimal(15, 2) @default(0)
  coPaymentPercentage Float           @default(0)
  isActive            Boolean         @default(true)
  effectiveDate       DateTime        @default(now())
  expiryDate          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  @@index([insuranceProviderId, serviceCategory])
  @@index([isActive])
  @@map("insurance_plans")
}

// ============================================================
// PRE-AUTHORISATION
// ============================================================

model PreAuthorisationRequest {
  id                    String        @id @default(cuid())
  referenceNumber       String        @unique
  attendanceId          String
  patientId             String
  insuranceProviderId   String
  requestedById         String
  requestedAt           DateTime      @default(now())
  requestedServices     Json
  estimatedTotalCost    Decimal       @db.Decimal(15, 2)
  clinicalJustification String?
  status                PreAuthStatus @default(pending)
  responseReceivedAt    DateTime?
  approvedAmount        Decimal?      @db.Decimal(15, 2)
  approvedServices      Json?
  rejectionReason       String?
  authNumber            String?
  authExpiry            DateTime?
  updatedById           String?
  updatedAt             DateTime      @updatedAt
  createdAt             DateTime      @default(now())

  attendance        Attendance        @relation(fields: [attendanceId], references: [id])
  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  requestedBy       User              @relation("PreAuth_requestedBy", fields: [requestedById], references: [id])
  updatedBy         User?             @relation("PreAuth_updatedBy", fields: [updatedById], references: [id])

  @@index([attendanceId])
  @@index([status])
  @@index([referenceNumber])
  @@map("pre_authorisation_requests")
}

// ============================================================
// ATTENDANCE (FIXED: Flexible Clinical Notes, NHIS Edge Cases)
// ============================================================

model Attendance {
  id                     String         @id @default(cuid())
  attendanceNumber       String         @unique
  patientId              String
  insuranceProviderId    String?
  corporateAccountId     String?
  bedId                  String?
  wardId                 String?
  attendanceType         AttendanceType
  dateTime               DateTime       @default(now())
  paymentMode            PaymentMode
  nhisCCC                String?
  
  // NHIS Edge Cases
  nhisCCCCode        String?
  nhisCCCGeneratedAt DateTime?
  nhisCCCValidUntil  DateTime?

  // ✅ RESTORED: All three clinical note fields serve different purposes
  complaints        String?          // ✅ Patient's chief complaint (reason for visit)
  medicalNotes      String?          // ✅ Doctor's clinical notes/observations
  clinicalNotes     Json?            // ✅ Structured clinical data
  
  // ✅ RESTORED: Both categories
  encounterCategory EncounterCategory @default(opd)
  visitCategory     VisitCategory     @default(general)
  
  gdrgCategory      String?
  serviceCategory   ServiceCategory?

  followUpDate DateTime?

  // Financial Summary
  totalBill          Decimal @db.Decimal(15, 2) @default(0)
  paidAmount         Decimal @db.Decimal(15, 2) @default(0)
  outstandingBalance Decimal @db.Decimal(15, 2) @default(0)

  // Insurance & Pre-Auth
  preAuthNumber     String?
  preAuthApproved   Boolean          @default(false)
  preAuthAmount     Decimal?         @db.Decimal(15, 2)
  
  status            AttendanceStatus @default(pending)
  referringFacility String?
  createdById       String
  updatedById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Corporate Employee Link
  CorporateEmployee   CorporateEmployee? @relation(fields: [corporateEmployeeId], references: [id])
  corporateEmployeeId String?
  
  // Classifications
  patientClassification   PatientClassification?  
  diagnosisClassification DiagnosisClassification?

  // Relations (same as before)
  Admission      Admission?      @relation("AttendanceAdmission")
  Bed            Bed?            @relation(fields: [bedId], references: [id])
  Ward           Ward?           @relation(fields: [wardId], references: [id])
  InsuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  CorporateAccount  CorporateAccount?  @relation(fields: [corporateAccountId], references: [id])
  Patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  User_Attendance_createdByIdToUser User  @relation("Attendance_createdByIdToUser", fields: [createdById], references: [id])
  User_Attendance_updatedByIdToUser User? @relation("Attendance_updatedByIdToUser", fields: [updatedById], references: [id])

  appointment      Appointment?       @relation 
  referral         ReferralRecord?    @relation
  insuranceClaim   InsuranceClaim?    @relation
  
  nhisEligibilityChecks NHISEligibilityCheck[] 

  AttendanceDiagnosis AttendanceDiagnosis[]
  Bill                Bill?
  LabTest             LabTest[]
  Medication          Medication[]
  Procedure           Procedure[]
  Scan                Scan[]
  ServiceRendered     ServiceRendered[]
  Vitals              Vitals[]
  PreAuthorisationRequest PreAuthorisationRequest[]
  WardChargeRecord    WardChargeRecord[]
  
  familyPlanningServices   FamilyPlanningService[]
  antenatalBookings        AntenatalBooking[] @relation("FirstANCAttendance")
  currentAntenatalBookings AntenatalBooking[] @relation("CurrentANCAttendance")
  antenatalVisits          ANCVisit[]
  deliveryRecords          DeliveryRecord[]
  abortionRecords          AbortionRecord[]
  postnatalRecords         PostnatalRecord[]
  proformaInvoices         ProformaInvoice[]

  @@index([nhisCCCCode])
  @@index([patientId, dateTime])
  @@index([insuranceProviderId])
  @@index([bedId])
  @@index([wardId])
  @@index([attendanceType])
  @@index([dateTime])
  @@index([patientId])
  @@index([paymentMode])
  @@index([corporateAccountId])
  @@index([status])
  @@index([gdrgCategory])
  @@index([serviceCategory])
  @@index([encounterCategory])
  @@index([visitCategory])
  @@index([dateTime, status])
}

// ============================================================
// CLINICAL
// ============================================================

model LabTest {
  id                String        @id @default(cuid())
  attendanceId      String
  templateId        String
  serviceCatalogId  String?
  status            LabTestStatus @default(requested)
  result            Json?
  normalRange       String?
  units             String?
  requestedAt       DateTime      @default(now())
  completedAt       DateTime?
  turnaroundMinutes Int?
  performedById     String?
  verifiedById      String?
  notes             String?
  createdById       String
  priority          Priority      @default(routine)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  Attendance                       Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_LabTest_createdByIdToUser   User            @relation("LabTest_createdByIdToUser", fields: [createdById], references: [id])
  User_LabTest_performedByIdToUser User?           @relation("LabTest_performedByIdToUser", fields: [performedById], references: [id])
  LabTestTemplate                  LabTestTemplate @relation(fields: [templateId], references: [id])
  User_LabTest_verifiedByIdToUser  User?           @relation("LabTest_verifiedByIdToUser", fields: [verifiedById], references: [id])
  ServiceCatalog                   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([attendanceId, status])
  @@index([templateId])
  @@index([requestedAt])
  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Scan {
  id                String       @id @default(cuid())
  attendanceId      String
  templateId        String
  serviceCatalogId  String?
  scanType          String
  description       String
  bodyPart          String?
  status            ScanStatus   @default(requested)
  requestedAt       DateTime     @default(now())
  completedAt       DateTime?
  turnaroundMinutes Int?
  result            String?
  findings          String?
  impression        String?
  performedById     String?
  verifiedById      String?
  imageUrls         String[]
  createdById       String
  priority          ScanPriority @default(routine)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  Attendance                    Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Scan_createdByIdToUser   User            @relation("Scan_createdByIdToUser", fields: [createdById], references: [id])
  User_Scan_performedByIdToUser User?           @relation("Scan_performedByIdToUser", fields: [performedById], references: [id])
  ScanTemplate                  ScanTemplate    @relation(fields: [templateId], references: [id])
  User_Scan_verifiedByIdToUser  User?           @relation("Scan_verifiedByIdToUser", fields: [verifiedById], references: [id])
  ServiceCatalog                ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([attendanceId, status])
  @@index([templateId])
  @@index([requestedAt])
  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Procedure {
  id                  String          @id @default(cuid())
  attendanceId        String
  templateId          String
  serviceCatalogId    String?
  status              ProcedureStatus @default(scheduled)
  scheduledDate       DateTime?
  performedAt         DateTime?
  performedById       String?
  assistantId         String?
  notes               String?
  complications       String?
  outcome             String?
  cost                Decimal?        @db.Decimal(15, 2)
  duration            Int?
  createdById         String
  anesthesiaNotes     String?
  intraOperativeNotes String?
  postOperativeNotes  String?
  bloodLoss           Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  User_Procedure_assistantIdToUser   User?             @relation("Procedure_assistantIdToUser", fields: [assistantId], references: [id])
  Attendance                         Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Procedure_createdByIdToUser   User              @relation("Procedure_createdByIdToUser", fields: [createdById], references: [id])
  User_Procedure_performedByIdToUser User?             @relation("Procedure_performedByIdToUser", fields: [performedById], references: [id])
  ProcedureTemplate                  ProcedureTemplate @relation(fields: [templateId], references: [id])
  ServiceCatalog                     ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id])

  @@index([attendanceId, status])
  @@index([templateId])
  @@index([performedAt])
  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model GDRGTariffProcedure {
  gdrgTariffId String
  procedureId  String
  isPrimary    Boolean  @default(false)
  mappedCode   String?
  createdAt    DateTime @default(now())

  gdrgTariff GDRGTariff     @relation(fields: [gdrgTariffId], references: [id])
  procedure  ServiceCatalog @relation(fields: [procedureId], references: [id])

  @@id([gdrgTariffId, procedureId])
  @@index([procedureId])
  @@map("gdrg_tariff_procedures")
}

model Medication {
  id                   String           @id @default(cuid())
  attendanceId         String
  stockItemId          String?
  serviceCatalogId     String?
  name                 String
  dosage               String?
  frequency            String?
  duration             String?
  quantity             Int              @default(1)
  route                String?
  instructions         String?
  status               MedicationStatus @default(prescribed)
  prescribedAt         DateTime         @default(now())
  dispensedAt          DateTime?
  administeredAt       DateTime?
  dispensedById        String?
  administeredById     String?
  prescribedById       String
  notes                String?
  dispensedBatchNumber String?
  dispensedExpiryDate  DateTime?
  dispensedUnitCost    Decimal?         @db.Decimal(15, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  administeredDoses Json?

  User_Medication_administeredByIdToUser User?           @relation("Medication_administeredByIdToUser", fields: [administeredById], references: [id])
  Attendance                             Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Medication_dispensedByIdToUser    User?           @relation("Medication_dispensedByIdToUser", fields: [dispensedById], references: [id])
  User_Medication_prescribedByIdToUser   User            @relation("Medication_prescribedByIdToUser", fields: [prescribedById], references: [id])
  StockItem                              StockItem?      @relation(fields: [stockItemId], references: [id])
  ServiceCatalog                         ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])

  @@index([attendanceId, status])
  @@index([prescribedAt])
  @@index([stockItemId])
  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Vitals {
  id            String   @id @default(cuid())
  attendanceId  String
  patientId     String
  bloodPressure String?
  temperature   Float?
  pulse         Int?
  respiration   Int?
  spo2          Float?
  weight        Float?
  height        Float?
  bmi           Float?
  muac          Float?
  notes         String?
  recordedById  String
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  Attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  Patient    Patient    @relation(fields: [patientId], references: [id])
  User       User       @relation(fields: [recordedById], references: [id])

  @@index([attendanceId, recordedAt])
  @@index([patientId, recordedAt])
  @@index([attendanceId])
  @@index([patientId])
}

model Ward {
  id                    String   @id @default(cuid())
  wardName              String
  wardType              String
  totalBeds             Int
  occupiedBeds          Int      @default(0)
  isActive              Boolean  @default(true)
  isNHISCovered         Boolean  @default(true)
  nhisRequiresAuth      Boolean  @default(false)
  isPrivateInsExempted  Boolean  @default(false)
  isPending             Boolean  @default(true)
  requiresAuthorization Boolean  @default(false)
  tariffCode            String?
  vatRate               Float    @default(0)
  isTaxable             Boolean  @default(true)
  dailyCashRate         Decimal  @db.Decimal(15, 2) @default(0)
  dailyNHISRate         Decimal  @db.Decimal(15, 2) @default(0)
