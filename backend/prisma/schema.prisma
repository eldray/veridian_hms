// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== STREAMLINED CORE MODELS ====================

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  password       String
  fullName       String
  role           UserRole
  email          String?
  phone          String?
  licenseNumber  String?
  specialization String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  departmentId   String?

  department Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])

  // Relations
  createdAttendances      Attendance[]          @relation("AttendanceCreatedBy")
  updatedAttendances      Attendance[]          @relation("AttendanceUpdatedBy")
  attendanceDiagnoses     AttendanceDiagnosis[]
  createdBills            Bill[]                @relation("BillCreatedBy")
  updatedBills            Bill[]                @relation("BillUpdatedBy")
  createdInsuranceClaims  InsuranceClaim[]      @relation("InsuranceClaimCreatedBy")
  updatedInsuranceClaims  InsuranceClaim[]      @relation("InsuranceClaimUpdatedBy")
  createdLabTests         LabTest[]             @relation("LabTestCreatedBy")
  performedLabTests       LabTest[]             @relation("LabTestPerformedBy")
  verifiedLabTests        LabTest[]             @relation("LabTestVerifiedBy")
  administeredMedications Medication[]          @relation("MedicationAdministeredBy")
  dispensedMedications    Medication[]          @relation("MedicationDispensedBy")
  prescribedMedications   Medication[]          @relation("MedicationPrescribedBy")
  assistedProcedures      Procedure[]           @relation("ProcedureAssistant")
  createdProcedures       Procedure[]           @relation("ProcedureCreatedBy")
  performedProcedures     Procedure[]           @relation("ProcedurePerformedBy")
  createdScans            Scan[]                @relation("ScanCreatedBy")
  performedScans          Scan[]                @relation("ScanPerformedBy")
  verifiedScans           Scan[]                @relation("ScanVerifiedBy")
  servicesRendered        ServiceRendered[]
  vitals                  Vitals[]
  doctorAppointments      Appointment[]         @relation("DoctorAppointments")
  headedDepartment        Department?           @relation("DepartmentHead")
  notifications           Notification[]
  createdServiceCatalogs  ServiceCatalog[]      @relation("ServiceCatalogCreatedBy")
  receivedPayments        Payment[]             @relation("PaymentReceivedBy")
  createdInvoices         Invoice[]             @relation("InvoiceCreatedBy")
  requestedRequisitions   Requisition[]         @relation("RequisitionRequestedBy")
  approvedRequisitions    Requisition[]         @relation("RequisitionApprovedBy")
  fulfilledRequisitions   Requisition[]         @relation("RequisitionFulfilledBy")

  @@map("users")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?  @unique
  isActive    Boolean  @default(true)
  color       String?  @default("#3B82F6")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]        @relation("DepartmentUsers")
  appointments Appointment[]
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id])
  requisitions Requisition[] @relation("RequisitionDepartment")

  @@map("departments")
}

// ==================== PATIENT & ATTENDANCE MODELS ====================

model Patient {
  id                  String       @id @default(cuid())
  folderNumber        String       @unique
  surname             String
  otherNames          String
  gender              Gender
  dateOfBirth         DateTime
  age                 Int
  ageInMonths         Int?
  contact             String
  address             String
  paymentMode         PaymentMode?
  insuranceNumber     String? // Patient's main insurance/membership/NHIS number
  insuranceDetails    Json?
  additionalInfo      Json?
  billingAddress      Json?
  employer            Json?
  imageUrl            String?
  registeredAt        DateTime     @default(now())
  registeredBy        String
  insuranceProviderId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  admissions        Admission[]
  attendances       Attendance[]
  beds              Bed[]
  bills             Bill[]
  insuranceClaims   InsuranceClaim[]
  insuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  vitals            Vitals[]
  appointments      Appointment[]

  @@index([folderNumber])
  @@index([paymentMode])
  @@index([surname])
  @@index([otherNames])
  @@index([insuranceNumber])
  @@map("patients")
}

model Attendance {
  id                  String  @id @default(cuid())
  attendanceNumber    String  @unique
  patientId           String
  insuranceProviderId String?
  bedId               String?
  wardId              String?

  // ✅ STREAMLINED ATTENDANCE TYPES
  attendanceType AttendanceType
  dateTime       DateTime       @default(now())
  paymentMode    PaymentMode
  nhisCCC        String? // CCC for THIS specific attendance/claim

  complaints   String  @default("No complaints recorded")
  medicalNotes String?

  // Service Categorization
  encounterCategory EncounterCategory @default(opd)
  visitCategory     VisitCategory     @default(general)

  // ✅ ADDED: Better NHIS claims grouping
  gdrgCategory    String? // adult_surgery, paediatrics, obstetrics, etc.
  serviceCategory ServiceCategory? // opd, ipd, diagnostics, pharmacy

  // Billing
  totalBill          Float @default(0)
  paidAmount         Float @default(0)
  outstandingBalance Float @default(0)

  // Insurance Claims
  insuranceClaimId String? @unique
  preAuthNumber    String?

  status            AttendanceStatus @default(pending)
  referringFacility String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  createdBy         User               @relation("AttendanceCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?              @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id])
  bed               Bed?               @relation(fields: [bedId], references: [id])
  ward              Ward?              @relation(fields: [wardId], references: [id])
  insuranceClaim    InsuranceClaim?    @relation("AttendanceInsuranceClaim")

  // Related entities
  diagnoses        AttendanceDiagnosis[]
  labTests         LabTest[]
  medications      Medication[]
  procedures       Procedure[]
  scans            Scan[]
  servicesRendered ServiceRendered[]
  vitals           Vitals[]
  bill             Bill?                 @relation("AttendanceBill")
  admission        Admission?            @relation("AdmissionAttendance")

  @@index([attendanceType])
  @@index([paymentMode])
  @@index([patientId])
  @@index([dateTime])
  @@index([status])
  @@index([nhisCCC])
  @@index([gdrgCategory]) // ✅ ADDED INDEX
  @@map("attendances")
}

// ==================== CLINICAL DATA MODELS ====================

model Diagnosis {
  id          String            @id @default(cuid())
  name        String
  icdCode     String            @unique
  gdrgCode    String
  description String?
  category    DiagnosisCategory
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  gdrgTariff          GDRGTariff?                   @relation(fields: [gdrgCode], references: [gdrgCode])
  principalAdmissions Admission[]                   @relation("PrincipalDiagnosis")
  secondaryAdmissions AdmissionSecondaryDiagnosis[]
  attendanceDiagnoses AttendanceDiagnosis[]
  serviceCatalogs     ServiceCatalog[]

  @@index([gdrgCode])
  @@map("diagnoses")
}

model AttendanceDiagnosis {
  id                 String              @id @default(cuid())
  attendanceId       String
  diagnosisId        String
  primary            Boolean             @default(false)
  notes              String?
  date               DateTime            @default(now())
  createdById        String
  icdCode            String?
  gdrgCategory       String?
  presentOnAdmission PresentOnAdmission?
  diagnosisType      DiagnosisType?
  createdAt          DateTime            @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])
  diagnosis  Diagnosis  @relation(fields: [diagnosisId], references: [id])

  @@unique([attendanceId, diagnosisId, diagnosisType])
  @@map("attendance_diagnoses")
}

model Vitals {
  id            String   @id @default(cuid())
  attendanceId  String
  patientId     String
  bloodPressure String?
  temperature   Float?
  pulse         Int?
  respiration   Int?
  spo2          Float?
  weight        Float?
  height        Float?
  bmi           Float?
  notes         String?
  recordedById  String
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id])
  recordedBy User       @relation(fields: [recordedById], references: [id])

  @@index([attendanceId])
  @@index([patientId])
  @@map("vitals")
}

// ==================== UNIFIED SERVICE CATALOG ====================

model ServiceCatalog {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?

  // Service Classification
  serviceType     ServiceType
  serviceCategory ServiceCategory @default(opd)
  subType         String? // hematology, surgery, ultrasound, etc.

  // NHIS Compliance
  nhisServiceCode  String? // Maps to JSON tariff codes (INVE01D, ASURO1A, etc.)
  tariffCode       String? // GDRG code if applicable
  isNHISCovered    Boolean          @default(true)
  nhisCoverageType NHISCoverageType @default(full)

  // Service Metadata (JSON for flexibility)
  metadata Json? // {specimenType, duration, bodyPart, preparationInstructions, etc.}

  // Authorization Requirements
  requiresAuthorization Boolean @default(false)
  isActive              Boolean @default(true)
  requiresClinicalNotes Boolean @default(false)

  unit        String   @default("Each")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy        User?             @relation("ServiceCatalogCreatedBy", fields: [createdById], references: [id])
  servicesRendered ServiceRendered[]
  pricing          ServicePricing?
  labTests         LabTest[]
  procedures       Procedure[]
  scans            Scan[]
  medications      Medication[]
  wardServices     WardService[]
  diagnosis        Diagnosis?        @relation(fields: [diagnosisId], references: [id])
  diagnosisId      String?

  @@index([serviceCategory, serviceType])
  @@index([serviceType, isActive])
  @@index([code])
  @@index([nhisServiceCode])
  @@map("service_catalog")
}

model ServicePricing {
  id               String   @id @default(cuid())
  serviceCatalogId String   @unique
  cashPrice        Float
  nhisPrice        Float
  insurancePrice   Float
  vatRate          Float    @default(0)
  isTaxable        Boolean  @default(true)
  effectiveDate    DateTime @default(now())
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  @@map("service_pricing")
}

// ==================== SERVICE EXECUTION MODELS ====================

model LabTest {
  id               String        @id @default(cuid())
  attendanceId     String
  serviceCatalogId String // Link to unified service catalog
  status           LabTestStatus @default(requested)
  result           Json?
  normalRange      String?
  units            String?
  requestedAt      DateTime      @default(now())
  completedAt      DateTime?
  performedById    String?
  verifiedById     String?
  notes            String?
  isActive         Boolean       @default(true)
  createdById      String
  priority         Priority      @default(routine)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("LabTestCreatedBy", fields: [createdById], references: [id])
  performedBy    User?          @relation("LabTestPerformedBy", fields: [performedById], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  verifiedBy     User?          @relation("LabTestVerifiedBy", fields: [verifiedById], references: [id])

  @@map("lab_tests")
}

model Procedure {
  id               String          @id @default(cuid())
  attendanceId     String
  serviceCatalogId String // Link to unified service catalog
  status           ProcedureStatus @default(scheduled)
  scheduledDate    DateTime?
  performedAt      DateTime?
  performedById    String?
  assistantId      String?
  notes            String?
  complications    String?
  outcome          String?
  cost             Float?
  duration         Int?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assistant      User?          @relation("ProcedureAssistant", fields: [assistantId], references: [id])
  attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ProcedureCreatedBy", fields: [createdById], references: [id])
  performedBy    User?          @relation("ProcedurePerformedBy", fields: [performedById], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  @@map("procedures")
}

model Scan {
  id               String       @id @default(cuid())
  attendanceId     String
  serviceCatalogId String // Link to unified service catalog
  status           ScanStatus   @default(requested)
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?
  result           String?
  findings         String?
  impression       String?
  performedById    String?
  verifiedById     String?
  imageUrls        String[]
  createdById      String
  priority         ScanPriority @default(routine)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ScanCreatedBy", fields: [createdById], references: [id])
  performedBy    User?          @relation("ScanPerformedBy", fields: [performedById], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  verifiedBy     User?          @relation("ScanVerifiedBy", fields: [verifiedById], references: [id])

  @@map("scans")
}

model Medication {
  id               String           @id @default(cuid())
  attendanceId     String
  serviceCatalogId String? // Link to unified service catalog for pricing
  stockItemId      String? // Link to inventory for dispensing
  name             String
  dosage           String?
  frequency        String?
  duration         String?
  quantity         Int              @default(1)
  route            String?
  instructions     String?
  status           MedicationStatus @default(prescribed)
  prescribedAt     DateTime         @default(now())
  dispensedAt      DateTime?
  administeredAt   DateTime?
  dispensedById    String?
  administeredById String?
  prescribedById   String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  administeredBy User?           @relation("MedicationAdministeredBy", fields: [administeredById], references: [id])
  attendance     Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  dispensedBy    User?           @relation("MedicationDispensedBy", fields: [dispensedById], references: [id])
  prescribedBy   User            @relation("MedicationPrescribedBy", fields: [prescribedById], references: [id])
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  stockItem      StockItem?      @relation(fields: [stockItemId], references: [id])

  @@map("medications")
}

model ServiceRendered {
  id               String   @id @default(cuid())
  attendanceId     String
  serviceCatalogId String
  quantity         Int      @default(1)
  date             DateTime @default(now())
  performedById    String
  notes            String?
  createdAt        DateTime @default(now())

  attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  performedBy    User           @relation(fields: [performedById], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  @@map("services_rendered")
}

// ==================== BILLING & CLAIMS MODELS ====================

model Bill {
  id                  String      @id @default(cuid())
  billNumber          String      @unique
  patientId           String
  attendanceId        String      @unique
  admissionId         String?
  items               Json // Simplified - will use service catalog pricing
  subtotal            Float       @default(0)
  discount            Float       @default(0)
  taxAmount           Float       @default(0)
  totalAmount         Float       @default(0)
  insuranceCovered    Float       @default(0)
  patientPayable      Float       @default(0)
  paidAmount          Float       @default(0)
  balance             Float       @default(0)
  status              BillStatus  @default(draft)
  paymentMode         PaymentMode
  insuranceProviderId String?
  preAuthNumber       String?
  claimNumber         String?
  claimStatus         ClaimStatus @default(draft)
  createdById         String
  updatedById         String?
  billDate            DateTime    @default(now())
  dueDate             DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  admission         Admission?         @relation(fields: [admissionId], references: [id])
  attendance        Attendance         @relation("AttendanceBill", fields: [attendanceId], references: [id])
  createdBy         User               @relation("BillCreatedBy", fields: [createdById], references: [id])
  insuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  updatedBy         User?              @relation("BillUpdatedBy", fields: [updatedById], references: [id])
  insuranceClaims   InsuranceClaim[]
  payments          Payment[]

  @@index([patientId])
  @@index([attendanceId])
  @@index([billNumber])
  @@index([status])
  @@index([billDate])
  @@map("bills")
}

model InsuranceClaim {
  id                  String      @id @default(cuid())
  claimNumber         String      @unique
  billId              String
  patientId           String
  insuranceProviderId String
  attendanceId        String      @unique
  totalClaimAmount    Float       @default(0)
  status              ClaimStatus @default(draft)

  // Complete claim data
  diagnosisCodes  String[] @default([])
  procedureCodes  String[] @default([])
  labTestCodes    String[] @default([])
  medicationCodes String[] @default([])
  scanCodes       String[] @default([])
  serviceCodes    String[] @default([])

  submissionDate DateTime?
  preAuthNumber  String?
  notes          String?
  createdById    String
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendance        Attendance        @relation("AttendanceInsuranceClaim", fields: [attendanceId], references: [id])
  bill              Bill              @relation(fields: [billId], references: [id], onDelete: Cascade)
  createdBy         User              @relation("InsuranceClaimCreatedBy", fields: [createdById], references: [id])
  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  patient           Patient           @relation(fields: [patientId], references: [id])
  updatedBy         User?             @relation("InsuranceClaimUpdatedBy", fields: [updatedById], references: [id])

  @@map("insurance_claims")
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  amount          Float
  paymentMethod   PaymentMethod
  reference       String?
  transactionDate DateTime      @default(now())
  receivedById    String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bill       Bill @relation(fields: [billId], references: [id])
  receivedBy User @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([billId])
  @@index([transactionDate])
  @@map("payments")
}

// ==================== INPATIENT MODELS ====================

model Admission {
  id                 String    @id @default(cuid())
  admissionNumber    String    @unique
  patientId          String
  attendanceId       String?   @unique
  wardId             String
  bedId              String
  admissionDate      DateTime
  admissionTime      String
  admittingDoctor    String
  reasonForAdmission String
  diagnosis          String
  status             String    @default("admitted")
  dischargeDate      DateTime?
  dischargeTime      String?
  dischargeSummary   String?
  dailyNotes         Json?
  createdBy          String

  // ✅ UPDATED: Added detention_observation
  admissionType   AdmissionType    @default(emergency)
  admissionSource AdmissionSource  @default(home)
  dischargeStatus DischargeStatus?
  lengthOfStay    Int              @default(0)

  principalDiagnosisId        String
  principalIcdCode            String
  principalPresentOnAdmission PresentOnAdmission @default(Y)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  attendance         Attendance?                   @relation("AdmissionAttendance", fields: [attendanceId], references: [id])
  bed                Bed                           @relation(fields: [bedId], references: [id])
  patient            Patient                       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  principalDiagnosis Diagnosis                     @relation("PrincipalDiagnosis", fields: [principalDiagnosisId], references: [id])
  ward               Ward                          @relation(fields: [wardId], references: [id])
  secondaryDiagnoses AdmissionSecondaryDiagnosis[]
  bills              Bill[]

  @@index([patientId])
  @@index([admissionNumber])
  @@index([status])
  @@index([admissionType]) // ✅ ADDED INDEX
  @@map("admissions")
}

model AdmissionSecondaryDiagnosis {
  id                 String                 @id @default(cuid())
  admissionId        String
  diagnosisId        String
  icdCode            String
  presentOnAdmission PresentOnAdmission     @default(Y)
  diagnosisType      SecondaryDiagnosisType
  createdAt          DateTime               @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id])

  @@unique([admissionId, diagnosisId, diagnosisType])
  @@map("admission_secondary_diagnoses")
}

model Ward {
  id           String   @id @default(cuid())
  wardName     String
  wardType     String
  totalBeds    Int
  occupiedBeds Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  admissions   Admission[]
  attendances  Attendance[]
  beds         Bed[]
  wardServices WardService[]

  @@map("wards")
}

model WardService {
  id               String   @id @default(cuid())
  wardId           String
  serviceCatalogId String
  createdAt        DateTime @default(now())

  ward           Ward           @relation(fields: [wardId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  @@unique([wardId, serviceCatalogId])
  @@map("ward_services")
}

model Bed {
  id               String   @id @default(cuid())
  wardId           String
  bedNumber        String
  isOccupied       Boolean  @default(false)
  currentPatientId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  admissions     Admission[]
  attendances    Attendance[]
  currentPatient Patient?     @relation(fields: [currentPatientId], references: [id])
  ward           Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, bedNumber])
  @@map("beds")
}

// ==================== INVENTORY MODELS ====================

model StockItem {
  id            String  @id @default(cuid())
  name          String
  category      String
  description   String?
  strength      String
  unitOfMeasure String
  drugCode      String  @unique

  // Stock Management
  reorderLevel Int
  currentStock Int @default(0)

  // Pricing now through ServiceCatalog
  costPrice    Float // For inventory costing only
  supplier     String?
  expiryDate   DateTime?
  batchNumber  String?
  isActive     Boolean   @default(true)
  isMedication Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medications       Medication[]
  stockTransactions StockTransaction[]
  invoiceItems      InvoiceItem[]      @relation("InvoiceItemStockItem")
  requisitionItems  RequisitionItem[]  @relation("RequisitionItemStockItem")

  @@map("stock_items")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  supplierName  String
  invoiceDate   DateTime
  totalAmount   Float
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy         User               @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  invoiceItems      InvoiceItem[]
  stockTransactions StockTransaction[]

  @@index([invoiceNumber])
  @@index([supplierName])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  stockItemId String
  quantity    Int
  unitCost    Float
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation("InvoiceItemStockItem", fields: [stockItemId], references: [id])

  @@unique([invoiceId, stockItemId])
  @@map("invoice_items")
}

model Requisition {
  id                     String             @id @default(cuid())
  requisitionNumber      String             @unique
  requestingDepartmentId String
  requestedById          String
  urgency                RequisitionUrgency @default(routine)
  requiredDate           DateTime?
  purpose                String?
  status                 RequisitionStatus  @default(draft)
  approvedById           String?
  approvedAt             DateTime?
  fulfilledById          String?
  fulfilledAt            DateTime?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  requestingDepartment Department         @relation("RequisitionDepartment", fields: [requestingDepartmentId], references: [id])
  requestedBy          User               @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedBy           User?              @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  fulfilledBy          User?              @relation("RequisitionFulfilledBy", fields: [fulfilledById], references: [id])
  requisitionItems     RequisitionItem[]
  stockTransactions    StockTransaction[]

  @@map("requisitions")
}

model RequisitionItem {
  id                String   @id @default(cuid())
  requisitionId     String
  stockItemId       String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int      @default(0)
  purpose           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stockItem   StockItem   @relation("RequisitionItemStockItem", fields: [stockItemId], references: [id])

  @@map("requisition_items")
}

model StockTransaction {
  id              String               @id @default(cuid())
  stockItemId     String
  transactionType StockTransactionType
  quantity        Int
  balanceAfter    Int
  reference       String? // Invoice number for purchases, Requisition number for requisitions
  notes           String?
  transactionDate DateTime             @default(now())
  performedBy     String
  requisitionId   String? // For requisition-based transactions
  invoiceId       String? // For purchase invoice-based transactions
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  stockItem   StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  requisition Requisition? @relation(fields: [requisitionId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])

  @@map("stock_transactions")
}

// ==================== SUPPORTING MODELS ====================

model InsuranceProvider {
  id                 String        @id @default(cuid())
  name               String        @unique
  type               InsuranceType
  coveragePercentage Float
  isActive           Boolean       @default(true)
  contactInfo        Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  attendances     Attendance[]
  bills           Bill[]
  insuranceClaims InsuranceClaim[]
  patients        Patient[]

  @@map("insurance_providers")
}

// Add to your schema.prisma
model GDRGTariff {
  id            String    @id @default(cuid())
  gdrgCode      String    @unique
  description   String
  category      String // adult_surgery, paediatrics, obstetrics, etc.
  nhiaTariff    Float
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  diagnoses Diagnosis[]

  @@index([gdrgCode])
  @@index([category])
  @@index([isActive])
  @@map("gdrg_tariffs")
}

model Hospital {
  id                      String       @id @default(cuid())
  name                    String
  address                 String
  phone                   String
  email                   String
  imageUrl                String?
  nhisFacilityCode        String       @unique
  nhisFacilityType        FacilityType @default(Primary)
  nhisAccreditationNumber String?
  nhisAccreditationDate   DateTime?
  nhisAccreditationExpiry DateTime?
  bankName                String?
  bankAccountNumber       String?
  bankBranch              String?
  nhisContactPerson       String?
  nhisContactPhone        String?
  nhisContactEmail        String?
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("hospitals")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique @default(uuid())
  patientId         String
  doctorId          String?
  departmentId      String?
  title             String
  description       String?
  appointmentDate   DateTime
  appointmentTime   String
  duration          Int               @default(30)
  status            AppointmentStatus @default(scheduled)
  type              AppointmentType   @default(consultation)
  reminderSent      Boolean           @default(false)
  checkedIn         Boolean           @default(false)
  checkedInAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String

  department Department? @relation(fields: [departmentId], references: [id])
  doctor     User?       @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType     @default(info)
  priority   NotificationPriority @default(medium)
  actionType String?
  actionId   String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  isArchived Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

