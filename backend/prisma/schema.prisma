  ANCVisit                                        ANCVisit[]
  ghsReportSubmissions                            GHSReportSubmission[]
  idsrAlerts                                      IDSRAlert[]
  deliveryRecords                                 DeliveryRecord[]
  antenatalBookingsCreated                        AntenatalBooking[]


  department       Department?      @relation("DepartmentUsers", fields: [departmentId], references: [id])
  headedDepartment Department?      @relation("DepartmentHead")
  abortionRecords  AbortionRecord[]
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType     @default(info)
  priority   NotificationPriority @default(medium)
  actionType String?
  actionId   String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  isArchived Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ServiceRendered {
  id            String   @id @default(cuid())
  attendanceId  String
  serviceItemId String
  quantity      Int      @default(1)
  date          DateTime @default(now())
  performedById String
  notes         String?
  createdAt     DateTime @default(now())

  Attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [performedById], references: [id])
  ServiceCatalog ServiceCatalog @relation(fields: [serviceItemId], references: [id])
}

// ============================================================
// GHS REPORTING MODELS
// ============================================================

model GHSReportSubmission {
  id                String        @id @default(cuid())
  reportType        GHSReportType
  reportingYear     Int
  reportingMonth    Int?
  reportingQuarter  Int?
  periodStart       DateTime
  periodEnd         DateTime
  data              Json
  filePath          String?
  submittedToDHIMS2 Boolean       @default(false)
  dhims2Reference   String?
  submittedAt       DateTime?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([reportType, reportingYear, reportingMonth])
  @@index([submittedToDHIMS2])
  @@map("ghs_report_submissions")
}

model IDSRAlert {
  id                String    @id @default(cuid())
  diseaseCode       String
  diseaseName       String
  alertDate         DateTime
  suspectedCases    Int
  confirmedCases    Int
  deaths            Int
  alertTriggered    Boolean   @default(false)
  alertAcknowledged Boolean   @default(false)
  acknowledgedAt    DateTime?
  acknowledgedById  String?
  responseNotes     String?
  createdAt         DateTime  @default(now())

  acknowledgedBy User? @relation(fields: [acknowledgedById], references: [id])

  @@index([diseaseCode, alertDate])
  @@index([alertTriggered, alertAcknowledged])
  @@map("idsr_alerts")
}

model MalariaCommodityStock {
  id             String               @id @default(cuid())
  commodityType  MalariaCommodityType
  reportingMonth DateTime
  openingStock   Int
  received       Int
  dispensed      Int
  closingStock   Int
  stockOutDays   Int                  @default(0)
  facilityId     String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([commodityType, reportingMonth, facilityId])
  @@index([reportingMonth])
  @@map("malaria_commodity_stocks")
}

model DeliveryRecord {
  id                String          @id @default(cuid())
  patientId         String
  attendanceId      String
  admissionId       String?
  deliveryDate      DateTime
  deliveryType      DeliveryType
  deliveryOutcome   DeliveryOutcome
  placeOfDelivery   PlaceOfDelivery
  attendant         String
  birthWeight       Float?
  gestationWeeks    Int?
  apgarScore1min    Int?
  apgarScore5min    Int?
  resusCitationDone Boolean         @default(false)
  maternalOutcome   MaternalOutcome
  referralTo        String?
  complications     String[]
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Foreign key for the reverse relation
  antenatalBookingId String?
  
  // Relations
  patient    Patient          @relation(fields: [patientId], references: [id])
  attendance Attendance       @relation(fields: [attendanceId], references: [id])
  Admission  Admission?       @relation(fields: [admissionId], references: [id])
  createdBy  User             @relation(fields: [createdById], references: [id])
  
  // This side has NO fields/references arguments - just @relation()
  antenatalBooking   AntenatalBooking? @relation()
  
  Newborn          NewbornRecord[]
  AbortionRecord   AbortionRecord? @relation(fields: [abortionRecordId], references: [id])
  abortionRecordId String?

  @@index([deliveryDate])
  @@index([patientId])
  @@map("delivery_records")
}

model NewbornRecord {
  id               String         @id @default(cuid())
  deliveryRecordId String
  birthWeight      Float
  gender           Gender
  apgarScore1min   Int?
  apgarScore5min   Int?
  resuscitation    Boolean        @default(false)
  outcome          NewbornOutcome
  anomalies        String[]
  referredTo       String?
  createdAt        DateTime       @default(now())

  deliveryRecord DeliveryRecord @relation(fields: [deliveryRecordId], references: [id])

  @@map("newborn_records")
}

model AbortionRecord {
  id               String          @id @default(cuid())
  patientId        String
  attendanceId     String
  abortionDate     DateTime
  gestationalWeeks Int
  abortionType     AbortionType
  complication     String?
  method           AbortionMethod?
  createdById      String
  createdAt        DateTime        @default(now())

  patient         Patient          @relation(fields: [patientId], references: [id])
  attendance      Attendance       @relation(fields: [attendanceId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  deliveryRecords DeliveryRecord[]

  @@index([abortionDate])
  @@map("abortion_records")
}

