  requestedBy User    @relation("Waiver_requestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("Waiver_approvedBy", fields: [approvedById], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("patient_waivers")
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  amount          Decimal       @db.Decimal(15, 2)
  paymentMethod   PaymentMethod
  reference       String?
  transactionDate DateTime      @default(now())
