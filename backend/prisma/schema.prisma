model Bill {
  id                  String      @id @default(cuid())
  billNumber          String      @unique
  patientId           String
  attendanceId        String      @unique
  admissionId         String?
  subtotal            Float       @default(0)
  discount            Float       @default(0)
  waiverAmount        Float       @default(0)
  taxAmount           Float       @default(0)
  totalAmount         Float       @default(0)
  insuranceCovered    Float       @default(0)
  patientPayable      Float       @default(0)
  paidAmount          Float       @default(0)
  balance             Float       @default(0)
  status              BillStatus  @default(draft)
  paymentMode         PaymentMode
  corporateAccountId  String?
  insuranceProviderId String?
  preAuthNumber       String?
  claimNumber         String?
  claimStatus         ClaimStatus @default(not_required)
  createdById         String
  updatedById         String?
  billDate            DateTime    @default(now())
  dueDate             DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  CorporateAccount            CorporateAccount?  @relation("CorporateAccountBills", fields: [corporateAccountId], references: [id])
  admission                   Admission?         @relation(fields: [admissionId], references: [id])
  Attendance                  Attendance         @relation(fields: [attendanceId], references: [id])
  InsuranceProvider           InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  Patient                     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_Bill_createdByIdToUser User               @relation("Bill_createdByIdToUser", fields: [createdById], references: [id])
  User_Bill_updatedByIdToUser User?              @relation("Bill_updatedByIdToUser", fields: [updatedById], references: [id])
  InsuranceClaim              InsuranceClaim[]
  Payment                     Payment[]
  BillLineItem                BillLineItem[]
  PatientWaiver               PatientWaiver[]
  ProformaInvoice             ProformaInvoice?

  @@index([attendanceId])
  @@index([billDate])
  @@index([billNumber])
  @@index([patientId])
  @@index([status])
  @@index([admissionId])
  @@index([createdAt])
}

model BillLineItem {
  id                     String      @id @default(cuid())
  billId                 String
  serviceCatalogId       String?
  description            String
  serviceType            ServiceType
  quantity               Int         @default(1)
  unitPrice              Float
  pricingBasis           PaymentMode
  vatRate                Float       @default(0)
  vatAmount              Float       @default(0)
  lineTotal              Float
  insuranceCoveredAmount Float       @default(0)
  patientPayableAmount   Float       @default(0)
  discount               Float       @default(0)
  pricingSnapshotId      String?
  isVoided               Boolean     @default(false)
  voidedById             String?
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime    @default(now())

  bill           Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  voidedBy       User?           @relation("BillLineItem_voidedBy", fields: [voidedById], references: [id])

  @@index([billId])
  @@index([serviceCatalogId])
  @@index([serviceType])
  @@map("bill_line_items")
}

model PatientWaiver {
  id              String       @id @default(cuid())
  patientId       String
  billId          String?
  waiverType      WaiverType
  reason          String
  amountRequested Float
  amountApproved  Float        @default(0)
  status          WaiverStatus @default(pending)
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  supportingDocs  String[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  patient     Patient @relation(fields: [patientId], references: [id])
  bill        Bill?   @relation(fields: [billId], references: [id])
  requestedBy User    @relation("Waiver_requestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("Waiver_approvedBy", fields: [approvedById], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("patient_waivers")
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  amount          Float
  paymentMethod   PaymentMethod
  reference       String?
  transactionDate DateTime      @default(now())
  receivedById    String
  notes           String?
  isVoided        Boolean       @default(false)
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  Bill     Bill  @relation(fields: [billId], references: [id])
  User     User  @relation("Payment_receivedBy", fields: [receivedById], references: [id])
  voidedBy User? @relation("Payment_voidedBy", fields: [voidedById], references: [id])

  @@index([billId])
  @@index([transactionDate])
}

