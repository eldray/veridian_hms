  updatedAt      DateTime             @updatedAt

  @@unique([commodityType, reportingMonth, facilityId])
  @@index([reportingMonth])
  @@map("malaria_commodity_stocks")
}

model DeliveryRecord {
  id                String          @id @default(cuid())
  patientId         String
  attendanceId      String
  admissionId       String?
  deliveryDate      DateTime
  deliveryType      DeliveryType
  deliveryOutcome   DeliveryOutcome
  placeOfDelivery   PlaceOfDelivery
  attendant         String
  birthWeight       Float?
  gestationWeeks    Int?
  apgarScore1min    Int?
  apgarScore5min    Int?
  resusCitationDone Boolean         @default(false)
  maternalOutcome   MaternalOutcome
  referralTo        String?
  complications     String[]
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  antenatalBookingId String?

  patient    Patient    @relation(fields: [patientId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id])
  admission  Admission? @relation(fields: [admissionId], references: [id])
  createdBy  User       @relation(fields: [createdById], references: [id])

  antenatalBooking AntenatalBooking? @relation()
  Newborn          NewbornRecord[]
  AbortionRecord   AbortionRecord?   @relation(fields: [abortionRecordId], references: [id])
