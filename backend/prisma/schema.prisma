// ============================================================
// BILLING (FIXED: Decimal Currency, GRA E-Invoicing)
// ============================================================

model Bill {
  id                  String      @id @default(cuid())
  billNumber          String      @unique
  patientId           String
  attendanceId        String      @unique
  admissionId         String?
  subtotal            Decimal     @db.Decimal(15, 2) @default(0)
  discount            Decimal     @db.Decimal(15, 2) @default(0)
  waiverAmount        Decimal     @db.Decimal(15, 2) @default(0)
  taxAmount           Decimal     @db.Decimal(15, 2) @default(0)
  totalAmount         Decimal     @db.Decimal(15, 2) @default(0)
  insuranceCovered    Decimal     @db.Decimal(15, 2) @default(0)
  patientPayable      Decimal     @db.Decimal(15, 2) @default(0)
  paidAmount          Decimal     @db.Decimal(15, 2) @default(0)
  balance             Decimal     @db.Decimal(15, 2) @default(0)
  status              BillStatus  @default(draft)
  paymentMode         PaymentMode
  corporateAccountId  String?
  insuranceProviderId String?
  preAuthNumber       String?
  claimNumber         String?
  claimStatus         ClaimStatus @default(not_required)
  createdById         String
  updatedById         String?
  billDate            DateTime    @default(now())
  dueDate             DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // NEW: GRA E-Invoicing Fields
  graDeclarationCode  String?
  graQrCodeData       String?
  graValidationStatus GraValidationStatus?

  CorporateAccount            CorporateAccount?  @relation("CorporateAccountBills", fields: [corporateAccountId], references: [id])
  admission                   Admission?         @relation(fields: [admissionId], references: [id])
  Attendance                  Attendance         @relation(fields: [attendanceId], references: [id])
  InsuranceProvider           InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  Patient                     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_Bill_createdByIdToUser User               @relation("Bill_createdByIdToUser", fields: [createdById], references: [id])
  User_Bill_updatedByIdToUser User?              @relation("Bill_updatedByIdToUser", fields: [updatedById], references: [id])
  InsuranceClaim              InsuranceClaim[]
  Payment                     Payment[]
  BillLineItem                BillLineItem[]
  PatientWaiver               PatientWaiver[]
  ProformaInvoice             ProformaInvoice?

  @@index([attendanceId])
  @@index([billDate])
  @@index([billNumber])
  @@index([patientId])
  @@index([status])
  @@index([admissionId])
  @@index([billDate, status])
  @@index([createdAt])
}

model BillLineItem {
  id                     String      @id @default(cuid())
  billId                 String
  serviceCatalogId       String?
  description            String
  serviceType            ServiceType
  quantity               Int         @default(1)
  unitPrice              Decimal     @db.Decimal(15, 2)
  pricingBasis           PaymentMode
  vatRate                Float       @default(0)
  vatAmount              Decimal     @db.Decimal(15, 2) @default(0)
  lineTotal              Decimal     @db.Decimal(15, 2)
  insuranceCoveredAmount Decimal     @db.Decimal(15, 2) @default(0)
  patientPayableAmount   Decimal     @db.Decimal(15, 2) @default(0)
  discount               Decimal     @db.Decimal(15, 2) @default(0)
  pricingSnapshotId      String?
  isVoided               Boolean     @default(false)
  voidedById             String?
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime    @default(now())

  bill           Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceCatalog ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
