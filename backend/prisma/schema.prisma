// ANTENATAL
// ============================================================

model AntenatalBooking {
  id                       String   @id @default(cuid())
  patientId                String   @unique
  pregnancyNumber          Int      @default(1)
  attendanceId             String   @unique
  currentAttendanceId      String?  @unique
  
  // Pregnancy dates
  bookingDate              DateTime
  lmp                      DateTime?
  edd                      DateTime?
  gestationalAgeWeeks      Int?
  
  // Obstetric history
  gravida                  Int
  para                     Int
  previousCSection         Boolean  @default(false)
  previousComplications    String?
  
  // IPTp Tracking (GHS Form A)
  iptpDoses                Json
  iptp1Date                DateTime?
  iptp2Date                DateTime?
  iptp3Date                DateTime?
  iptp4Date                DateTime?
  iptp5Date                DateTime?
  
  // TT Vaccination (GHS Form A)
  ttDoses                  Json
  tt1Date                  DateTime?
  tt2Date                  DateTime?
  tt3Date                  DateTime?
  tt4Date                  DateTime?
  tt5Date                  DateTime?
  
  // Malaria in Pregnancy
  malariaTested            Boolean  @default(false)
  malariaPositive          Boolean  @default(false)
  malariaTreatment         String?
  malariaIPTpGiven         Boolean  @default(false)
  
  // Anaemia
  hbBooking                Float?
  hb36Weeks                Float?
  anaemiaDiagnosed         Boolean  @default(false)
  ironFolateGiven          Boolean  @default(false)
  
  // ITN/LLIN
  itnGiven                 Boolean  @default(false)
  itnGivenDate             DateTime?
  
  // Risk assessment
  riskLevel                AntenatalRisk
  riskFactors              Json?
  
  // Delivery outcome
  deliveryRecordId         String?  @unique
  deliveryOutcome          String?
  deliveryDate             DateTime?
  
  // Status
  isActive                 Boolean  @default(true)
  isCompleted              Boolean  @default(false)
  
  // Audit
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  // Relations
  patient                  Patient              @relation(fields: [patientId], references: [id])
  attendance               Attendance           @relation("FirstANCAttendance", fields: [attendanceId], references: [id])
  currentAttendance        Attendance?          @relation("CurrentANCAttendance", fields: [currentAttendanceId], references: [id])
  deliveryRecord           DeliveryRecord?      @relation(fields: [deliveryRecordId], references: [id])
  visits                   ANCVisit[]
  createdBy                User                 @relation(fields: [createdById], references: [id])
}

model ANCVisit {
  id                       String   @id @default(cuid())
  bookingId                String
  attendanceId             String   @unique
  visitNumber              Int
  
  // Visit data
  visitDate                DateTime
  gestationalAgeWeeks      Int?
  weight                   Float?
  bloodPressure            String?
  fundalHeight             Int?
  fetalHeartRate           Int?
  fetalMovements           Boolean?
  presentation             String?
  
  // Oedema
  oedema                   Boolean  @default(false)
  oedemaGrade              String?
  
  // Urinalysis
  urinalysisProtein        Boolean?
  urinalysisGlucose        Boolean?
  urinalysisBlood          Boolean?
  
  // IPTp at this visit
  iptpGiven                Boolean  @default(false)
  iptpDoseNumber           Int?
  iptpDrug                 String?
  
  // TT at this visit
  ttGiven                  Boolean  @default(false)
  ttDoseNumber             Int?
  
  // Supplements
  ironGiven                Boolean  @default(false)
  folateGiven              Boolean  @default(false)
  calciumGiven             Boolean  @default(false)
  
  // Malaria screening
  malariaTestDone          Boolean  @default(false)
  malariaTestResult        String?
  malariaTreatmentGiven    Boolean  @default(false)
  
  // Danger signs
  dangerSignsPresent       Boolean  @default(false)
  dangerSignsList          String[]
  referralMade             Boolean  @default(false)
  referredTo               String?
  
  // Next visit
  nextVisitDate            DateTime?
  returnInstructions       String?
  
  // Audit
  recordedById             String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  
  // Relations
  booking                  AntenatalBooking @relation(fields: [bookingId], references: [id])
  attendance               Attendance       @relation(fields: [attendanceId], references: [id])
  recordedBy               User             @relation(fields: [recordedById], references: [id])
  
  @@unique([bookingId, visitNumber])
}

