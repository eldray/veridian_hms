  hivStatus  String?
  hbLevel    Float?
  vdrl       String?

  iptpDoses Json
  iptp1Date DateTime?
  iptp2Date DateTime?
  iptp3Date DateTime?
  iptp4Date DateTime?
  iptp5Date DateTime?

  ttDoses Json
  tt1Date DateTime?
  tt2Date DateTime?
  tt3Date DateTime?
  tt4Date DateTime?
  tt5Date DateTime?

