  User_Requisition_requestedByIdToUser User               @relation("Requisition_requestedByIdToUser", fields: [requestedById], references: [id])
  departments                          Department         @relation(fields: [requestingDepartmentId], references: [id])
  RequisitionItem                      RequisitionItem[]
  StockTransaction                     StockTransaction[]
}

model RequisitionItem {
  id                String   @id @default(cuid())
  requisitionId     String
  stockItemId       String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int      @default(0)
  purpose           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  StockItem   StockItem   @relation(fields: [stockItemId], references: [id])
}

// ============================================================
// APPOINTMENTS & DEPARTMENTS
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?  @unique
  isActive    Boolean  @default(true)
  color       String?  @default("#3B82F6")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Requisitions Requisition[]
  users        User[]        @relation("DepartmentUsers")
  appointments Appointment[]
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([headId])
  @@map("departments")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique @default(uuid())
  patientId         String
  doctorId          String?
  departmentId      String?
  title             String
  description       String?
  appointmentDate   DateTime
  appointmentTime   String
  duration          Int               @default(30)
  status            AppointmentStatus @default(scheduled)
  type              AppointmentType   @default(consultation)
  isNHIS            Boolean           @default(false)
  nhisCCC           String?
  reminderSent      Boolean           @default(false)
  checkedIn         Boolean           @default(false)
  checkedInAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  doctor     User?       @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([appointmentDate])
  @@index([patientId, status])
  @@index([doctorId, appointmentDate])
  @@index([departmentId, appointmentDate])
  @@index([status, appointmentDate])
  @@map("appointments")
}

