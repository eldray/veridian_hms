  User               User               @relation(fields: [createdById], references: [id])
  InvoiceItem        InvoiceItem[]
  StockTransaction   StockTransaction[]
  CorporateAccount   CorporateAccount?  @relation(fields: [corporateAccountId], references: [id])
  corporateAccountId String?

  @@index([invoiceDate])
  @@index([invoiceNumber])
  @@index([supplierName])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  stockItemId String
  quantity    Int
  unitCost    Float
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  Invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  StockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([invoiceId, stockItemId])
}

model StockTransaction {
  id              String               @id @default(cuid())
  stockItemId     String
  transactionType StockTransactionType
  quantity        Int
  balanceAfter    Int
  reference       String?
  notes           String?
  transactionDate DateTime             @default(now())
  performedBy     String
  requisitionId   String?
  invoiceId       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  Invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  Requisition Requisition? @relation(fields: [requisitionId], references: [id])
  StockItem   StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId, transactionDate])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([requisitionId])
  @@index([invoiceId])
}

model Requisition {
  id                     String             @id @default(cuid())
  requisitionNumber      String             @unique
  requestingDepartmentId String
  requestedById          String
  urgency                RequisitionUrgency @default(routine)
  requiredDate           DateTime?
  purpose                String?
  status                 RequisitionStatus  @default(draft)
  approvedById           String?
  approvedAt             DateTime?
  fulfilledById          String?
  fulfilledAt            DateTime?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  User_Requisition_approvedByIdToUser  User?              @relation("Requisition_approvedByIdToUser", fields: [approvedById], references: [id])
  User_Requisition_fulfilledByIdToUser User?              @relation("Requisition_fulfilledByIdToUser", fields: [fulfilledById], references: [id])
  User_Requisition_requestedByIdToUser User               @relation("Requisition_requestedByIdToUser", fields: [requestedById], references: [id])
  departments                          Department         @relation(fields: [requestingDepartmentId], references: [id])
  RequisitionItem                      RequisitionItem[]
  StockTransaction                     StockTransaction[]
}

model RequisitionItem {
  id                String   @id @default(cuid())
  requisitionId     String
  stockItemId       String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int      @default(0)
  purpose           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  StockItem   StockItem   @relation(fields: [stockItemId], references: [id])
}

// ============================================================
// APPOINTMENTS & DEPARTMENTS
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?  @unique
  isActive    Boolean  @default(true)
  color       String?  @default("#3B82F6")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Requisitions Requisition[]
  users        User[]        @relation("DepartmentUsers")
  appointments Appointment[]
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([headId])
  @@map("departments")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique
  patientId         String
  clinicianId       String?
  clinicianRole     UserRole?
  departmentId      String?
  title             String
  description       String?
  appointmentDate   DateTime
  appointmentTime   String
  duration          Int               @default(30)
  status            AppointmentStatus @default(scheduled)
  type              AppointmentType   @default(consultation)
  reminderSent      Boolean           @default(false)
  checkedIn         Boolean           @default(false)
  checkedInAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String
  
  attendance   Attendance?
  
  clinician  User?       @relation("ClinicianAppointments", fields: [clinicianId], references: [id])
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([appointmentDate])
  @@index([patientId, status])
  @@index([clinicianId, appointmentDate])
  @@index([departmentId, appointmentDate])
  @@index([status, appointmentDate])
  @@map("appointments")
}

