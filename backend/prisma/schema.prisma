  expiryDate             DateTime?
  batchNumber            String?
  isActive               Boolean   @default(true)
  tariffCode             String?
  vatRate                Float     @default(0)
  isTaxable              Boolean   @default(true)
  isMedication           Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  InvoiceItem      InvoiceItem[]
  Medication       Medication[]
  RequisitionItem  RequisitionItem[]
  ServiceCatalog   ServiceCatalog[]
  StockTransaction StockTransaction[]
  StockBatch       StockBatch[]
  transferItems    StockTransferItem[]
}

model StockBatch {
  id           String   @id @default(cuid())
  stockItemId  String
  batchNumber  String
  expiryDate   DateTime
  quantity     Int
  receivedDate DateTime @default(now())
  costPrice    Decimal  @db.Decimal(15, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  // ✅ NEW: Which department/store currently holds this specific batch?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([stockItemId, batchNumber])
  @@index([stockItemId, expiryDate])
  @@index([departmentId])  // ← Add index for department lookups
  @@index([departmentId, stockItemId])  // ← Composite index for inventory queries
  @@map("stock_batches")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  supplierName  String
  invoiceDate   DateTime
  totalAmount   Decimal  @db.Decimal(15, 2)
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ✅ NEW: Which store/department physically received this invoice's goods?
  receivedAtDepartmentId String?
  receivedAtDepartment   Department? @relation(fields: [receivedAtDepartmentId], references: [id])

  User               User               @relation(fields: [createdById], references: [id])
  InvoiceItem        InvoiceItem[]
  StockTransaction   StockTransaction[]
  CorporateAccount   CorporateAccount?  @relation(fields: [corporateAccountId], references: [id])
  corporateAccountId String?

  @@index([invoiceDate])
  @@index([invoiceNumber])
  @@index([supplierName])
  @@index([receivedAtDepartmentId])  // ← Add index for department receiving reports
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  stockItemId String
  quantity    Int
  unitCost    Decimal   @db.Decimal(15, 2)
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  Invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  StockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([invoiceId, stockItemId])
}

model StockTransaction {
  id              String               @id @default(cuid())
  stockItemId     String
  transactionType StockTransactionType
  quantity        Int
  balanceAfter    Int
  reference       String?
  notes           String?
  transactionDate DateTime             @default(now())
  performedBy     String
  requisitionId   String?
  invoiceId       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  // ✅ NEW: The department where this transaction occurred
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  Invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  Requisition Requisition? @relation(fields: [requisitionId], references: [id])
  StockItem   StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId, transactionDate])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([requisitionId])
  @@index([invoiceId])
  @@index([departmentId])  // ← Add index for department audit trails
  @@index([departmentId, transactionDate])  // ← Composite for department reports
}

model Requisition {
  id                     String             @id @default(cuid())
  requisitionNumber      String             @unique
  requestingDepartmentId String
  requestedById          String
  urgency                RequisitionUrgency @default(routine)
  requiredDate           DateTime?
  purpose                String?
  status                 RequisitionStatus  @default(draft)
  approvedById           String?
  approvedAt             DateTime?
  fulfilledById          String?
  fulfilledAt            DateTime?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  User_Requisition_approvedByIdToUser  User?              @relation("Requisition_approvedByIdToUser", fields: [approvedById], references: [id])
  User_Requisition_fulfilledByIdToUser User?              @relation("Requisition_fulfilledByIdToUser", fields: [fulfilledById], references: [id])
  User_Requisition_requestedByIdToUser User               @relation("Requisition_requestedByIdToUser", fields: [requestedById], references: [id])
  departments                          Department         @relation(fields: [requestingDepartmentId], references: [id])
  RequisitionItem                      RequisitionItem[]
  StockTransaction                     StockTransaction[]
}

model RequisitionItem {
  id                String   @id @default(cuid())
  requisitionId     String
  stockItemId       String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int      @default(0)
  purpose           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  StockItem   StockItem   @relation(fields: [stockItemId], references: [id])
}

enum TransferStatus {
  requested
  approved
  dispatched
  received
  cancelled
}

model StockTransfer {
  id                String         @id @default(cuid())
  transferNumber    String         @unique
  originId          String
  destinationId     String
  status            TransferStatus @default(requested)
  requestedById     String
  approvedById      String?
  dispatchedAt      DateTime?
  receivedAt        DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  origin            Department     @relation("OriginDepartment", fields: [originId], references: [id])
  destination       Department     @relation("DestinationDepartment", fields: [destinationId], references: [id])
  requestedBy       User           @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy        User?          @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  
  items             StockTransferItem[]

  @@index([originId, status])
  @@index([destinationId, status])
  @@index([transferNumber])
  @@index([createdAt])
  @@index([status])
}

model StockTransferItem {
  id                String @id @default(cuid())
  transferId        String
  stockItemId       String
  quantityRequested Int
  quantitySent      Int      @default(0)
  quantityReceived  Int      @default(0)
  
  transfer          StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  stockItem         StockItem     @relation(fields: [stockItemId], references: [id])

  @@unique([transferId, stockItemId])
  @@index([stockItemId])
}

