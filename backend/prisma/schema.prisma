generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============== NEW MODELS ===============
model ServicePricing {
  id               String         @id @default(cuid())
  serviceCatalogId String         @unique
  cashPrice        Float
  nhisPrice        Float          @default(0)
  insurancePrice   Float
  vatRate          Float          @default(0)
  isTaxable        Boolean        @default(true)
  effectiveDate    DateTime       @default(now())
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  serviceCatalog   ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Cascade)

  @@map("service_pricing")
}

// =============== ENHANCED MODELS ===============
model ServiceCatalog {
  id                         String           @id @default(cuid())
  name                       String
  code                       String           @unique
  description                String?
  serviceCategory            ServiceCategory  @default(opd)
  serviceType                ServiceType
  // REMOVED direct pricing fields since we have ServicePricing now
  nhisServiceCode            String?
  isNHISCovered              Boolean          @default(true)
  tariffCode                 String?
  nhisCoverageType           NHISCoverageType @default(full)
  nhisRequiresAuth           Boolean          @default(false)
  privateInsRequiresAuth     Boolean          @default(false)
  isPrivateInsuranceExempted Boolean          @default(false)
  unit                       String           @default("Each")
  isPending                  Boolean          @default(true)
  requiresClinicalNotes      Boolean          @default(false)

  // NEW FIELDS for enhanced functionality
  subType  String? // lab category, procedure category, etc.
  metadata Json? // service-specific configuration
  isActive Boolean @default(true)

  // Enhanced relationships
  diagnosisId         String?
  labTestTemplateId   String?
  procedureTemplateId String?
  stockItemId         String?
  wardId              String?
  scanTemplateId      String?
  consultationTypeId  String?
  createdById         String?

  // Relations
  User              User?              @relation(fields: [createdById], references: [id])
  Diagnosis         Diagnosis?         @relation(fields: [diagnosisId], references: [id])
  LabTestTemplate   LabTestTemplate?   @relation(fields: [labTestTemplateId], references: [id])
  ProcedureTemplate ProcedureTemplate? @relation(fields: [procedureTemplateId], references: [id])
  ScanTemplate      ScanTemplate?      @relation(fields: [scanTemplateId], references: [id])
  StockItem         StockItem?         @relation(fields: [stockItemId], references: [id])
  Ward              Ward?              @relation(fields: [wardId], references: [id])
  ConsultationType  ConsultationType?  @relation(fields: [consultationTypeId], references: [id])

  // New pricing relationship
  pricing         ServicePricing?
  ServiceRendered ServiceRendered[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  labTests    LabTest[]
  scans       Scan[]
  procedures  Procedure[]
  medications Medication[]

  @@index([code])
  @@index([isPrivateInsuranceExempted])
  @@index([nhisCoverageType])
  @@index([nhisServiceCode])
  @@index([serviceCategory, serviceType])
  @@index([serviceType, isPending])
  @@index([isActive])
}

// =============== MODELS WITH SERVICE CATALOG RELATIONSHIPS ===============
model LabTest {
  id               String        @id @default(cuid())
  attendanceId     String
  templateId       String
  serviceCatalogId String? // NEW: Link to service catalog
  status           LabTestStatus @default(requested)
  result           Json?
  normalRange      String?
  units            String?
  requestedAt      DateTime      @default(now())
  completedAt      DateTime?
  performedById    String?
  verifiedById     String?
  notes            String?
  createdById      String
  priority         Priority      @default(routine)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  Attendance                       Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_LabTest_createdByIdToUser   User            @relation("LabTest_createdByIdToUser", fields: [createdById], references: [id])
  User_LabTest_performedByIdToUser User?           @relation("LabTest_performedByIdToUser", fields: [performedById], references: [id])
  LabTestTemplate                  LabTestTemplate @relation(fields: [templateId], references: [id])
  User_LabTest_verifiedByIdToUser  User?           @relation("LabTest_verifiedByIdToUser", fields: [verifiedById], references: [id])
  ServiceCatalog                   ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id]) // NEW

  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Scan {
  id               String       @id @default(cuid())
  attendanceId     String
  templateId       String
  serviceCatalogId String? // NEW: Link to service catalog
  scanType         String
  description      String
  bodyPart         String?
  status           ScanStatus   @default(requested)
  requestedAt      DateTime     @default(now())
  completedAt      DateTime?
  result           String?
  findings         String?
  impression       String?
  performedById    String?
  verifiedById     String?
  imageUrls        String[]
  createdById      String
  priority         ScanPriority @default(routine)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  Attendance                    Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Scan_createdByIdToUser   User            @relation("Scan_createdByIdToUser", fields: [createdById], references: [id])
  User_Scan_performedByIdToUser User?           @relation("Scan_performedByIdToUser", fields: [performedById], references: [id])
  ScanTemplate                  ScanTemplate    @relation(fields: [templateId], references: [id])
  User_Scan_verifiedByIdToUser  User?           @relation("Scan_verifiedByIdToUser", fields: [verifiedById], references: [id])
  ServiceCatalog                ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id]) // NEW

  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Procedure {
  id               String          @id @default(cuid())
  attendanceId     String
  templateId       String
  serviceCatalogId String? // NEW: Link to service catalog
  status           ProcedureStatus @default(scheduled)
  scheduledDate    DateTime?
  performedAt      DateTime?
  performedById    String?
  assistantId      String?
  notes            String?
  complications    String?
  outcome          String?
  cost             Float?
  duration         Int?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  User_Procedure_assistantIdToUser   User?             @relation("Procedure_assistantIdToUser", fields: [assistantId], references: [id])
  Attendance                         Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Procedure_createdByIdToUser   User              @relation("Procedure_createdByIdToUser", fields: [createdById], references: [id])
  User_Procedure_performedByIdToUser User?             @relation("Procedure_performedByIdToUser", fields: [performedById], references: [id])
  ProcedureTemplate                  ProcedureTemplate @relation(fields: [templateId], references: [id])
  ServiceCatalog                     ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id]) // NEW

  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

model Medication {
  id               String           @id @default(cuid())
  attendanceId     String
  stockItemId      String?
  serviceCatalogId String? // NEW: Link to service catalog
  name             String
  dosage           String?
  frequency        String?
  duration         String?
  quantity         Int              @default(1)
  route            String?
  instructions     String?
  status           MedicationStatus @default(prescribed)
  prescribedAt     DateTime         @default(now())
  dispensedAt      DateTime?
  administeredAt   DateTime?
  dispensedById    String?
  administeredById String?
  prescribedById   String
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  User_Medication_administeredByIdToUser User?           @relation("Medication_administeredByIdToUser", fields: [administeredById], references: [id])
  Attendance                             Attendance      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_Medication_dispensedByIdToUser    User?           @relation("Medication_dispensedByIdToUser", fields: [dispensedById], references: [id])
  User_Medication_prescribedByIdToUser   User            @relation("Medication_prescribedByIdToUser", fields: [prescribedById], references: [id])
  StockItem                              StockItem?      @relation(fields: [stockItemId], references: [id])
  ServiceCatalog                         ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id]) // NEW

  @@index([attendanceId])
  @@index([serviceCatalogId])
  @@index([status])
}

// =============== ENHANCED ATTENDANCE MODEL ===============
model Attendance {
  id                  String            @id @default(cuid())
  attendanceNumber    String            @unique
  patientId           String
  insuranceProviderId String?
  bedId               String?
  wardId              String?
  attendanceType      AttendanceType
  dateTime            DateTime          @default(now())
  paymentMode         PaymentMode
  nhisCCC             String?
  complaints          String            @default("No complaints recorded")
  medicalNotes        String?
  encounterCategory   EncounterCategory @default(opd)
  visitCategory       VisitCategory     @default(general)

  // NEW FIELDS for enhanced functionality
  gdrgCategory    String? // For NHIS GDRG categorization
  serviceCategory ServiceCategory? // Main service category

  totalBill          Float            @default(0)
  paidAmount         Float            @default(0)
  outstandingBalance Float            @default(0)
  insuranceClaimId   String?          @unique
  preAuthNumber      String?
  preAuthApproved    Boolean          @default(false)
  preAuthAmount      Float?
  status             AttendanceStatus @default(pending)
  referringFacility  String?
  createdById        String
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  Admission                         Admission?
  Bed                               Bed?                  @relation(fields: [bedId], references: [id])
  User_Attendance_createdByIdToUser User                  @relation("Attendance_createdByIdToUser", fields: [createdById], references: [id])
  InsuranceProvider                 InsuranceProvider?    @relation(fields: [insuranceProviderId], references: [id])
  Patient                           Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_Attendance_updatedByIdToUser User?                 @relation("Attendance_updatedByIdToUser", fields: [updatedById], references: [id])
  Ward                              Ward?                 @relation(fields: [wardId], references: [id])
  AttendanceDiagnosis               AttendanceDiagnosis[]
  Bill                              Bill?
  InsuranceClaim                    InsuranceClaim?
  LabTest                           LabTest[]
  Medication                        Medication[]
  Procedure                         Procedure[]
  Scan                              Scan[]
  ServiceRendered                   ServiceRendered[]
  Vitals                            Vitals[]

  @@index([attendanceType])
  @@index([dateTime])
  @@index([patientId])
  @@index([paymentMode])
  @@index([status])
  @@index([gdrgCategory])
  @@index([serviceCategory])
}

// =============== ENHANCED INSURANCE CLAIM MODEL ===============
model InsuranceClaim {
  id                  String      @id @default(cuid())
  claimNumber         String      @unique
  billId              String
  patientId           String
  insuranceProviderId String
  attendanceId        String      @unique
  totalClaimAmount    Float       @default(0)
  approvedAmount      Float?
  rejectedAmount      Float?
  paidAmount          Float?
  status              ClaimStatus @default(draft)
  submissionDate      DateTime?
  approvalDate        DateTime?
  paymentDate         DateTime?
  preAuthNumber       String?

  // ENHANCED: Support for all service types
  diagnosisCodes String[]
  procedureCodes String[]
  labTestCodes   String[] // NEW
  serviceCodes   String[] // NEW
  scanCodes      String[] // NEW

  notes       String?
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  Attendance                            Attendance        @relation(fields: [attendanceId], references: [id])
  Bill                                  Bill              @relation(fields: [billId], references: [id], onDelete: Cascade)
  User_InsuranceClaim_createdByIdToUser User              @relation("InsuranceClaim_createdByIdToUser", fields: [createdById], references: [id])
  InsuranceProvider                     InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])
  Patient                               Patient           @relation(fields: [patientId], references: [id])
  User_InsuranceClaim_updatedByIdToUser User?             @relation("InsuranceClaim_updatedByIdToUser", fields: [updatedById], references: [id])

  @@index([claimNumber])
  @@index([status])
  @@index([submissionDate])
}

// =============== EXISTING MODELS (UPDATED WITH CUID) ===============
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  headId      String?  @unique
  isActive    Boolean  @default(true)
  color       String?  @default("#3B82F6")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Requisitions Requisition[]
  users        User[]        @relation("DepartmentUsers")
  appointments Appointment[]
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([headId])
  @@map("departments")
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique @default(uuid())
  patientId         String
  doctorId          String?
  departmentId      String?
  title             String
  description       String?
  appointmentDate   DateTime
  appointmentTime   String
  duration          Int               @default(30)
  status            AppointmentStatus @default(scheduled)
  type              AppointmentType   @default(consultation)
  isNHIS            Boolean           @default(false)
  nhisCCC           String?
  reminderSent      Boolean           @default(false)
  checkedIn         Boolean           @default(false)
  checkedInAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         String

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  doctor     User?       @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: SetNull)
  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([appointmentDate])
  @@index([patientId, status])
  @@index([doctorId, appointmentDate])
  @@index([departmentId, appointmentDate])
  @@index([status, appointmentDate])
  @@map("appointments")
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  message    String
  type       NotificationType     @default(info)
  priority   NotificationPriority @default(medium)
  actionType String?
  actionId   String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  isArchived Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readAt     DateTime?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Admission {
  id                          String                        @id @default(cuid())
  admissionNumber             String                        @unique
  patientId                   String
  attendanceId                String?                       @unique
  wardId                      String
  bedId                       String
  admissionDate               DateTime
  admissionTime               String
  admittingDoctor             String
  reasonForAdmission          String
  diagnosis                   String
  status                      String                        @default("admitted")
  dischargeDate               DateTime?
  dischargeTime               String?
  dischargeSummary            String?
  dailyNotes                  Json?
  createdBy                   String
  admissionType               AdmissionType                 @default(emergency)
  admissionSource             AdmissionSource               @default(home)
  dischargeStatus             DischargeStatus?
  lengthOfStay                Int                           @default(0)
  principalDiagnosisId        String
  principalIcdCode            String
  principalPresentOnAdmission PresentOnAdmission            @default(Y)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @default(now())
  Attendance                  Attendance?                   @relation(fields: [attendanceId], references: [id])
  Bed                         Bed                           @relation(fields: [bedId], references: [id])
  Patient                     Patient                       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Diagnosis                   Diagnosis                     @relation(fields: [principalDiagnosisId], references: [id])
  Ward                        Ward                          @relation(fields: [wardId], references: [id])
  AdmissionSecondaryDiagnosis AdmissionSecondaryDiagnosis[]
  Bill                        Bill[]

  @@index([admissionNumber])
  @@index([patientId])
  @@index([status])
}

model AdmissionSecondaryDiagnosis {
  id                 String                 @id @default(cuid())
  admissionId        String
  diagnosisId        String
  icdCode            String
  presentOnAdmission PresentOnAdmission     @default(Y)
  diagnosisType      SecondaryDiagnosisType
  createdAt          DateTime               @default(now())
  Admission          Admission              @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  Diagnosis          Diagnosis              @relation(fields: [diagnosisId], references: [id])

  @@unique([admissionId, diagnosisId, diagnosisType])
}

model AttendanceDiagnosis {
  id                 String              @id @default(cuid())
  attendanceId       String
  diagnosisId        String
  primary            Boolean             @default(false)
  notes              String?
  date               DateTime            @default(now())
  createdById        String
  icdCode            String?
  presentOnAdmission PresentOnAdmission?
  diagnosisType      DiagnosisType?
  createdAt          DateTime            @default(now())
  Attendance         Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User               User                @relation(fields: [createdById], references: [id])
  Diagnosis          Diagnosis           @relation(fields: [diagnosisId], references: [id])
}

model Bed {
  id               String       @id @default(cuid())
  wardId           String
  bedNumber        String
  isOccupied       Boolean      @default(false)
  currentPatientId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now())
  Admission        Admission[]
  Attendance       Attendance[]
  Patient          Patient?     @relation(fields: [currentPatientId], references: [id])
  Ward             Ward         @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, bedNumber])
}

model Bill {
  id                          String             @id @default(cuid())
  billNumber                  String             @unique
  patientId                   String
  attendanceId                String             @unique
  admissionId                 String?
  items                       Json
  subtotal                    Float              @default(0)
  discount                    Float              @default(0)
  taxAmount                   Float              @default(0)
  totalAmount                 Float              @default(0)
  insuranceCovered            Float              @default(0)
  patientPayable              Float              @default(0)
  paidAmount                  Float              @default(0)
  balance                     Float              @default(0)
  status                      BillStatus         @default(draft)
  paymentMode                 PaymentMode
  insuranceProviderId         String?
  preAuthNumber               String?
  claimNumber                 String?
  claimStatus                 ClaimStatus        @default(not_required)
  createdById                 String
  updatedById                 String?
  billDate                    DateTime           @default(now())
  dueDate                     DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
  Admission                   Admission?         @relation(fields: [admissionId], references: [id])
  Attendance                  Attendance         @relation(fields: [attendanceId], references: [id])
  User_Bill_createdByIdToUser User               @relation("Bill_createdByIdToUser", fields: [createdById], references: [id])
  InsuranceProvider           InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  Patient                     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  User_Bill_updatedByIdToUser User?              @relation("Bill_updatedByIdToUser", fields: [updatedById], references: [id])
  InsuranceClaim              InsuranceClaim[]
  Payment                     Payment[]

  @@index([attendanceId])
  @@index([billDate])
  @@index([billNumber])
  @@index([patientId])
  @@index([status])
}

model ConsultationType {
  id                   String           @id @default(cuid())
  name                 String
  code                 String           @unique
  cashPrice            Float
  nhisPrice            Float            @default(0)
  insurancePrice       Float
  isNHISCovered        Boolean          @default(true)
  isPrivateInsExempted Boolean          @default(false)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  serviceCatalogs      ServiceCatalog[]
}

model Diagnosis {
  id                          String                        @id @default(cuid())
  name                        String                        
  icdCode                     String                        @unique
  gdrgCode                    String                         
  variant                     DiagnosisVariant?
  description                 String?
  isActive                   Boolean                       @default(true)
  requiresAuthorization       Boolean                       @default(false)
  tariffCode                  String?
  isChronic                   Boolean                       @default(false)
  isNHISCovered               Boolean                       @default(true)
  category                    DiagnosisCategory             @default(infectiousAndParasitic)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  Admission                   Admission[]
  AdmissionSecondaryDiagnosis AdmissionSecondaryDiagnosis[]
  AttendanceDiagnosis         AttendanceDiagnosis[]
  GDRGTariff                  GDRGTariff[]
  ServiceCatalog              ServiceCatalog[]
}

model GDRGTariff {
  id            String    @id @default(cuid())
  gdrgCode      String    @unique
  description   String
  category      String
  nhiaTariff    Float
  ageGroup      String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  diagnosisId   String
  Diagnosis     Diagnosis @relation(fields: [diagnosisId], references: [id])

  @@index([gdrgCode, effectiveFrom])
  @@index([isActive])
  @@index([category])
}

model Hospital {
  id                      String       @id @default(cuid())
  name                    String
  address                 String
  phone                   String
  email                   String
  imageUrl                String?
  nhisFacilityCode        String       @unique
  nhisFacilityType        FacilityType @default(Primary)
  nhisAccreditationNumber String?
  nhisAccreditationDate   DateTime?
  nhisAccreditationExpiry DateTime?
  bankName                String?
  bankAccountNumber       String?
  bankBranch              String?
  nhisContactPerson       String?
  nhisContactPhone        String?
  nhisContactEmail        String?
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model InsuranceProvider {
  id                 String           @id @default(cuid())
  name               String           @unique
  type               InsuranceType
  coveragePercentage Float
  isActive           Boolean          @default(true)
  contactInfo        Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  Attendance         Attendance[]
  Bill               Bill[]
  InsuranceClaim     InsuranceClaim[]
  Patient            Patient[]
}

model Invoice {
  id               String             @id @default(cuid())
  invoiceNumber    String             @unique
  supplierName     String
  invoiceDate      DateTime
  totalAmount      Float
  notes            String?
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  User             User               @relation(fields: [createdById], references: [id])
  InvoiceItem      InvoiceItem[]
  StockTransaction StockTransaction[]

  @@index([invoiceDate])
  @@index([invoiceNumber])
  @@index([supplierName])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  stockItemId String
  quantity    Int
  unitCost    Float
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  Invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  StockItem   StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([invoiceId, stockItemId])
}

model LabTestTemplate {
  id                     String           @id @default(cuid())
  name                   String
  investigationCode      String           @unique
  category               LabCategory
  subCategory            String?
  description            String?
  // REMOVED pricing fields since we have ServicePricing now
  isNHISCovered          Boolean          @default(true)
  isPrivateInsExempted   Boolean          @default(false)
  nhisRequiresAuth       Boolean          @default(false)
  privateInsRequiresAuth Boolean          @default(false)
  isActive               Boolean          @default(true)
  tariffCode             String?
  vatRate                Float            @default(0)
  isTaxable              Boolean          @default(true)
  specimenType           SpecimenType
  resultTemplate         Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  LabTest                LabTest[]
  ServiceCatalog         ServiceCatalog[]
}

model Patient {
  id                  String             @id @default(cuid())
  folderNumber        String             @unique
  surname             String
  otherNames          String
  gender              Gender
  dateOfBirth         DateTime
  age                 Int
  ageInMonths         Int?
  contact             String
  address             String
  paymentMode         PaymentMode?
  insuranceDetails    Json?
  additionalInfo      Json?
  billingAddress      Json?
  employer            Json?
  imageUrl            String?
  registeredAt        DateTime           @default(now())
  registeredBy        String
  insuranceProviderId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  Admission           Admission[]
  Attendance          Attendance[]
  Bed                 Bed?
  Bill                Bill[]
  InsuranceClaim      InsuranceClaim[]
  InsuranceProvider   InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  Vitals              Vitals[]
  appointments        Appointment[]

  @@index([folderNumber])
  @@index([otherNames])
  @@index([paymentMode])
  @@index([surname])
}

model Payment {
  id              String        @id @default(cuid())
  billId          String
  amount          Float
  paymentMethod   PaymentMethod
  reference       String?
  transactionDate DateTime      @default(now())
  receivedById    String
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Bill            Bill          @relation(fields: [billId], references: [id])
  User            User          @relation(fields: [receivedById], references: [id])

  @@index([billId])
  @@index([transactionDate])
}

model ProcedureTemplate {
  id                     String            @id @default(cuid())
  name                   String
  procedureCode          String            @unique
  description            String?
  category               ProcedureCategory
  department             String
  isNHISCovered          Boolean           @default(true)
  isPrivateInsExempted   Boolean           @default(false)
  nhisRequiresAuth       Boolean           @default(false)
  privateInsRequiresAuth Boolean           @default(false)
  isActive               Boolean           @default(true)
  tariffCode             String?
  vatRate                Float             @default(0)
  isTaxable              Boolean           @default(true)
  duration               Int               @default(30)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime
  Procedure              Procedure[]
  ServiceCatalog         ServiceCatalog[]
}

model Requisition {
  id                                   String             @id @default(cuid())
  requisitionNumber                    String             @unique
  requestingDepartmentId               String
  requestedById                        String
  urgency                              RequisitionUrgency @default(routine)
  requiredDate                         DateTime?
  purpose                              String?
  status                               RequisitionStatus  @default(draft)
  approvedById                         String?
  approvedAt                           DateTime?
  fulfilledById                        String?
  fulfilledAt                          DateTime?
  notes                                String?
  createdAt                            DateTime           @default(now())
  updatedAt                            DateTime
  User_Requisition_approvedByIdToUser  User?              @relation("Requisition_approvedByIdToUser", fields: [approvedById], references: [id])
  User_Requisition_fulfilledByIdToUser User?              @relation("Requisition_fulfilledByIdToUser", fields: [fulfilledById], references: [id])
  User_Requisition_requestedByIdToUser User               @relation("Requisition_requestedByIdToUser", fields: [requestedById], references: [id])
  departments                          Department         @relation(fields: [requestingDepartmentId], references: [id])
  RequisitionItem                      RequisitionItem[]
  StockTransaction                     StockTransaction[]
}

model RequisitionItem {
  id                String      @id @default(cuid())
  requisitionId     String
  stockItemId       String
  quantityRequested Int
  quantityApproved  Int?
  quantityFulfilled Int         @default(0)
  purpose           String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  Requisition       Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  StockItem         StockItem   @relation(fields: [stockItemId], references: [id])
}

model ScanTemplate {
  id                      String           @id @default(cuid())
  name                    String
  investigationCode       String
  scanCode                String           @unique
  description             String
  category                ScanCategory
  bodyPart                BodyPart
  isNHISCovered           Boolean          @default(true)
  isPrivateInsExempted    Boolean          @default(false)
  nhisRequiresAuth        Boolean          @default(false)
  privateInsRequiresAuth  Boolean          @default(false)
  isActive               Boolean          @default(true)
  tariffCode              String?
  vatRate                 Float            @default(0)
  isTaxable               Boolean          @default(true)
  preparationInstructions String?
  duration                Int
  contrastRequired        Boolean          @default(false)
  scanType                String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  Scan                    Scan[]
  ServiceCatalog          ServiceCatalog[]
}

model ServiceRendered {
  id             String         @id @default(cuid())
  attendanceId   String
  serviceItemId  String
  quantity       Int            @default(1)
  date           DateTime       @default(now())
  performedById  String
  notes          String?
  createdAt      DateTime       @default(now())
  Attendance     Attendance     @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [performedById], references: [id])
  ServiceCatalog ServiceCatalog @relation(fields: [serviceItemId], references: [id])
}

model StockItem {
  id                     String             @id @default(cuid())
  name                   String
  category               String
  description            String?
  strength               String
  unitOfMeasure          String
  drugCode               String             @unique
  reorderLevel           Int
  currentStock           Int                @default(0)
  costPrice              Float
  // REMOVED pricing fields since we have ServicePricing now
  isNHISCovered          Boolean            @default(true)
  isPrivateInsExempted   Boolean            @default(false)
  nhisRequiresAuth       Boolean            @default(false)
  privateInsRequiresAuth Boolean            @default(false)
  supplier               String?
  expiryDate             DateTime?
  batchNumber            String?
  isActive               Boolean            @default(true)
  tariffCode             String?
  vatRate                Float              @default(0)
  isTaxable              Boolean            @default(true)
  isMedication           Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  InvoiceItem            InvoiceItem[]
  Medication             Medication[]
  RequisitionItem        RequisitionItem[]
  ServiceCatalog         ServiceCatalog[]
  StockTransaction       StockTransaction[]
}

model StockTransaction {
  id              String               @id @default(cuid())
  stockItemId     String
  transactionType StockTransactionType
  quantity        Int
  balanceAfter    Int
  reference       String?
  notes           String?
  transactionDate DateTime             @default(now())
  performedBy     String
  requisitionId   String?
  invoiceId       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  Invoice         Invoice?             @relation(fields: [invoiceId], references: [id])
  Requisition     Requisition?         @relation(fields: [requisitionId], references: [id])
  StockItem       StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  password       String
  fullName       String
  role           UserRole
  email          String?
  phone          String?
  licenseNumber  String?
  specialization String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt 
  departmentId   String?

  // Relations
  Attendance_Attendance_createdByIdToUser         Attendance[]          @relation("Attendance_createdByIdToUser")
  Attendance_Attendance_updatedByIdToUser         Attendance[]          @relation("Attendance_updatedByIdToUser")
  AttendanceDiagnosis                             AttendanceDiagnosis[]
  Bill_Bill_createdByIdToUser                     Bill[]                @relation("Bill_createdByIdToUser")
  Bill_Bill_updatedByIdToUser                     Bill[]                @relation("Bill_updatedByIdToUser")
  InsuranceClaim_InsuranceClaim_createdByIdToUser InsuranceClaim[]      @relation("InsuranceClaim_createdByIdToUser")
  InsuranceClaim_InsuranceClaim_updatedByIdToUser InsuranceClaim[]      @relation("InsuranceClaim_updatedByIdToUser")
  Invoice                                         Invoice[]
  LabTest_LabTest_createdByIdToUser               LabTest[]             @relation("LabTest_createdByIdToUser")
  LabTest_LabTest_performedByIdToUser             LabTest[]             @relation("LabTest_performedByIdToUser")
  LabTest_LabTest_verifiedByIdToUser              LabTest[]             @relation("LabTest_verifiedByIdToUser")
  Medication_Medication_administeredByIdToUser    Medication[]          @relation("Medication_administeredByIdToUser")
  Medication_Medication_dispensedByIdToUser       Medication[]          @relation("Medication_dispensedByIdToUser")
  Medication_Medication_prescribedByIdToUser      Medication[]          @relation("Medication_prescribedByIdToUser")
  Payment                                         Payment[]
  Procedure_Procedure_assistantIdToUser           Procedure[]           @relation("Procedure_assistantIdToUser")
  Procedure_Procedure_createdByIdToUser           Procedure[]           @relation("Procedure_createdByIdToUser")
  Procedure_Procedure_performedByIdToUser         Procedure[]           @relation("Procedure_performedByIdToUser")
  Requisition_Requisition_approvedByIdToUser      Requisition[]         @relation("Requisition_approvedByIdToUser")
  Requisition_Requisition_fulfilledByIdToUser     Requisition[]         @relation("Requisition_fulfilledByIdToUser")
  Requisition_Requisition_requestedByIdToUser     Requisition[]         @relation("Requisition_requestedByIdToUser")
  Scan_Scan_createdByIdToUser                     Scan[]                @relation("Scan_createdByIdToUser")
  Scan_Scan_performedByIdToUser                   Scan[]                @relation("Scan_performedByIdToUser")
  Scan_Scan_verifiedByIdToUser                    Scan[]                @relation("Scan_verifiedByIdToUser")
  ServiceCatalog                                  ServiceCatalog[]
  ServiceRendered                                 ServiceRendered[]
  Vitals                                          Vitals[]
  doctorAppointments                              Appointment[]         @relation("DoctorAppointments")
  notifications                                   Notification[]

  department       Department? @relation("DepartmentUsers", fields: [departmentId], references: [id])
  headedDepartment Department? @relation("DepartmentHead")
}

model Vitals {
  id            String     @id @default(cuid())
  attendanceId  String
  patientId     String
  bloodPressure String?
  temperature   Float?
  pulse         Int?
  respiration   Int?
  spo2          Float?
  weight        Float?
  height        Float?
  bmi           Float?
  notes         String?
  recordedById  String
  recordedAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  Attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  Patient       Patient    @relation(fields: [patientId], references: [id])
  User          User       @relation(fields: [recordedById], references: [id])

  @@index([attendanceId])
  @@index([patientId])
}

model Ward {
  id                    String           @id @default(cuid())
  wardName              String
  wardType              String
  totalBeds             Int
  occupiedBeds          Int              @default(0)
  isNHISCovered         Boolean          @default(true)
  nhisRequiresAuth      Boolean          @default(false)
  isPrivateInsExempted  Boolean          @default(false)
  isPending             Boolean          @default(true)
  requiresAuthorization Boolean          @default(false)
  tariffCode            String?
  vatRate               Float            @default(0)
  isTaxable             Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  Admission             Admission[]
  Attendance            Attendance[]
  Bed                   Bed[]
  ServiceCatalog        ServiceCatalog[]
}

