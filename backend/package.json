{
  "name": "hospital-backend",
  "version": "1.0.0",
  "description": "Hospital Management System Backend API",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "prestart": "prisma generate --schema=prisma/schema.prisma",
    "start": "tsx src/server.ts",
    "predev": "prisma generate --schema=prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "dev:nogen": "tsx watch src/server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/seedData.ts",
    "gen:types": "tsx src/scripts/generateFrontendTypes.ts",
    "gen:meds": "tsx src/scripts/updateMedications.ts",
    "gen:nhis": "tsx src/scripts/parseNHISMedicines.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "bundle": "node scripts/bundle.mjs dist-bundle",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "prebuild": "prisma generate --schema=prisma/schema.prisma"
  },
  "keywords": [
    "hospital",
    "healthcare",
    "management",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.5.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-validator": "^6.12.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.14",
    "path-to-regexp": "^8.3.0",
    "pdf2json": "^4.1.1",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/json5": "^0.0.30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.10.1",
    "prisma": "6.5.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
