{
  "name": "veridian-hms",
  "version": "1.0.0",
  "description": "Veridian Hospital Management System",
  "license": "ISC",
  "author": "Emmanuel Appiah <emk.appiah@gmail.com>",
  "main": "main.cjs",
  "scripts": {
    "client": "cd frontend && npm run dev",
    "server": "cd backend && npm run dev",
    "start": "concurrently \"npm run client\" \"npm run server\"",
    "start:public": "concurrently \"npm run client\" \"npm run server:public\"",
    "server:public": "cd backend && node server.js",
    "electron:dev": "concurrently \"npm run client\" \"npm run server\" \"electron .\"",
    "electron:preview": "electron .",
    "build:win": "node build-win.js",
    "build:clean": "node -e \"['release','build/backend','backend/dist','frontend/dist'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true});console.log('removed',d)}catch(e){}})\"" 
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.38",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  }
}